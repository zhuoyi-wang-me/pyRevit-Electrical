<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Tray Runs" Width="720" Height="760" MinWidth="640" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F3F3F3" Foreground="#1B1B1B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ============ Windows 11 look: buttons ============ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F2F2F2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E9E9E9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Accent" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#005FB8" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A6FBF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#3380C6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#BDBDBD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ text field: rounded, accent line when in use ============ -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="White" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Background="#8A8A8A" CornerRadius="0,0,4,4" Margin="1,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F9F9F9"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="line" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="line" Property="Height" Value="2"/>
                                <Setter TargetName="b" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ check box ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A" Background="White" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="1.6" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ cards ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Tag Tray Runs" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock x:Name="lblView" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- what is tagged, with which tag -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Tag these, with this tag type" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Text="Tag style" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox x:Name="cmbStyle" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,10,10,0"/>
                <CheckBox x:Name="chkTrays" Grid.Row="1" Content="Cable Trays" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbTrays" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,6"/>
                <TextBlock x:Name="lblTrays" Grid.Row="1" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <CheckBox x:Name="chkConduits" Grid.Row="2" Content="Conduits" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbConduits" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="lblConduits" Grid.Row="2" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- how -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.RowSpan="5" Margin="0,0,12,0">
                    <CheckBox x:Name="chkSelected" Content="Only the selected elements" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkLinks" Content="Also trays of linked models" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkSkip" Content="Leave runs that already have a tag" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkInside" Content="Keep the tags inside the annotation crop" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkBundle" Content="Tag trays side by side together (one stack)" Margin="0,0,0,10"
                              ToolTip="Style 'with a leader': at each place, the trays running side by side are tagged in one stack"/>
                    <CheckBox x:Name="chkWalls" Content="Keep the tags off the walls" ToolTip="Also curved walls, and the walls of linked models" Margin="0,0,0,10"/>
                    <CheckBox x:Name="chkHatch" Content="Keep the tags inside the hatch" Margin="0,0,0,6"
                              ToolTip="Where a tray runs through a filled region of the view, its tags stand inside that region"/>
                    <ComboBox x:Name="cmbHatch" Height="30" Margin="26,0,0,0" VerticalContentAlignment="Center"
                              ToolTip="Which filled region type is the hatch"/>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Repeat the tag along a run every (m)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="txtSpacing" Grid.Row="0" Grid.Column="2" Style="{StaticResource Field}" Margin="0,0,0,8" HorizontalContentAlignment="Center"
                         ToolTip="Measured along the run in the model. A run shorter than this gets one tag."/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Leader: tray to text (mm on the sheet)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="txtLeader" Grid.Row="3" Grid.Column="2" Style="{StaticResource Field}" HorizontalContentAlignment="Center"
                         ToolTip="Style 'with a leader': how far the text stands from the tray"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Side by side: trays within (mm on the sheet)" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBox x:Name="txtBundle" Grid.Row="4" Grid.Column="2" Style="{StaticResource Field}" HorizontalContentAlignment="Center" Margin="0,8,0,0"
                         ToolTip="Trays this close to each other (square to the run) go into one stack"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="No-leader style: distance from the tray (mm)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="txtOffset" Grid.Row="1" Grid.Column="2" Style="{StaticResource Field}" Margin="0,0,0,8" HorizontalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Space around each tag (mm on the sheet)" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBox x:Name="txtGap" Grid.Row="2" Grid.Column="2" Style="{StaticResource Field}" Margin="0,0,0,8" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="barMessages" Grid.Row="3" CornerRadius="6" Padding="14,8" Margin="0,12,0,0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" VerticalAlignment="Top">
            <TextBox x:Name="txtMessages" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"/>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="btnRefresh" Content="Refresh" HorizontalAlignment="Left" ToolTip="Read the active view and the selection again"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnPreview" Content="Preview options..." Style="{StaticResource Accent}" Margin="0,0,8,0"
                        ToolTip="Shows the possible arrangements as drawings; you pick one, only that one is created"/>
                <Button x:Name="btnCreate" Content="Tag runs" ToolTip="Create with the settings above, without preview"/>
                <Button x:Name="btnClose" Content="Close" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>