<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cable Tray QA/QC - Sheets to check" Width="900" Height="720" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#EEF4FF" FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="False">

  <!-- Styles are shared with ui.xaml (sheet_picker.py copies its Window.Resources here) -->
  {{RESOURCES}}

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="16,10" CornerRadius="10" Margin="0,0,0,10">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#1E88E5" Offset="0"/>
          <GradientStop Color="#00ACC1" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock Text="Sheets to check" Foreground="White" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Tick the sheets whose cable tray annotations should be compared with the Excel. The filters only narrow the list; they do not change what is ticked."
                   Foreground="#EAF7FF" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- ================= FILTERS ================= -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <Border BorderBrush="#90CAF9" BorderThickness="1.5" CornerRadius="5" Background="White" Margin="0,0,0,8">
          <Grid>
            <TextBlock x:Name="search_hint" Text="Search sheet number or name (several words narrow the search)..."
                       Foreground="#9AA5B1" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBox x:Name="search_tb" Height="28" BorderThickness="0" Background="Transparent"
                     VerticalContentAlignment="Center" Padding="6,0"/>
          </Grid>
        </Border>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Number series" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,6,0"/>
          <ComboBox x:Name="series_cb" Grid.Column="1" Height="26" VerticalContentAlignment="Center"
                    ToolTip="The part of the sheet number before its first digit, e.g. E- for E-301"/>
          <TextBlock Grid.Column="2" Text="Parameter" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="14,0,6,0"/>
          <ComboBox x:Name="param_cb" Grid.Column="3" Height="26" VerticalContentAlignment="Center"
                    ToolTip="Any sheet parameter that has a value, e.g. Discipline, Zone, Sheet Issue Date, Drawn By"/>
          <TextBlock Grid.Column="4" Text="is" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0,6,0"/>
          <ComboBox x:Name="value_cb" Grid.Column="5" Height="26" VerticalContentAlignment="Center"/>
        </Grid>
        <WrapPanel Margin="0,8,0,0">
          <CheckBox x:Name="chk_annotated" Content="Only sheets with cable tray annotations (from the last check)"
                    VerticalAlignment="Center" Margin="0,0,20,0"/>
          <CheckBox x:Name="chk_ticked" Content="Only ticked sheets" VerticalAlignment="Center" Margin="0,0,20,0"/>
          <Button x:Name="btn_reset" Content="Clear filters" Height="26" Padding="10,0"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,0,0,8">
      <Button x:Name="btn_all" Content="Tick shown" Height="28" Style="{StaticResource BlueBtn}"/>
      <Button x:Name="btn_none" Content="Untick shown" Height="28"/>
      <Button x:Name="btn_invert" Content="Invert shown" Height="28"/>
      <TextBlock x:Name="shown_tb" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right"
                 Foreground="{StaticResource Muted}"/>
      <TextBlock x:Name="count_tb" VerticalAlignment="Center" Foreground="#283593" FontWeight="SemiBold" Margin="8,0,0,0"/>
    </DockPanel>

    <DataGrid x:Name="grid" Grid.Row="3" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3EAF5"
              BorderBrush="#C5D5F0" Background="White" RowHeight="26" AlternatingRowBackground="#F8FAFF"
              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling">
      <DataGrid.ColumnHeaderStyle>
        <Style TargetType="DataGridColumnHeader">
          <Setter Property="Background" Value="#1F3A5F"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Padding" Value="8,6"/>
          <Setter Property="BorderBrush" Value="#3B5B86"/>
          <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
      </DataGrid.ColumnHeaderStyle>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="CHECK" Width="62" SortMemberPath="Sel">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Sel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="SHEET NUMBER" Binding="{Binding Number}" Width="150" IsReadOnly="True"/>
        <DataGridTextColumn Header="SHEET NAME" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
        <DataGridTextColumn Header="PARAMETER VALUE" Binding="{Binding Value}" Width="*" IsReadOnly="True"/>
        <DataGridTextColumn Header="ANNOTATIONS" Binding="{Binding Found}" Width="105" IsReadOnly="True"
                            ElementStyle="{StaticResource Num}"/>
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="4" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="btn_ok" Content="Use these sheets" Style="{StaticResource GreenBtn}" IsDefault="True"/>
        <Button x:Name="btn_cancel" Content="Cancel" IsCancel="True" Margin="0"/>
      </StackPanel>
      <TextBlock x:Name="hint_tb" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,12,0"
                 Text="Highlight rows with Ctrl / Shift + click and press Space to tick or untick them together."/>
    </DockPanel>
  </Grid>
</Window>
