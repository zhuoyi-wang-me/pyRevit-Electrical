<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cable Tray Layout" Width="960" Height="920" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A6270"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,10"
                   Text="Cable Tray Layout  -  drafting views from a cable schedule"/>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Text="Cable schedule file"/>
                <TextBox x:Name="txtFile" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Padding="4"
                         VerticalContentAlignment="Center" ToolTip="Excel workbook (.xlsx) or CSV file"/>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnBrowse" Content="Browse..."/>
                    <Button x:Name="btnTemplate" Content="Save template..."
                            ToolTip="Saves an example CSV file with the column headings this tool reads"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="Excel sheet"/>
                <ComboBox x:Name="cmbSheet" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" IsEnabled="False"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="Calculation method"/>
                <ComboBox x:Name="cmbMethod" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>

                <!-- what to create: the tray drawings, the table, or both -->
                <CheckBox x:Name="chkTrays" Grid.Row="7" Grid.Column="0" Margin="0,8,10,0" VerticalAlignment="Center"
                          IsChecked="True" Content="Cable tray views"
                          ToolTip="Creates the tray drawings (cross-sections with cables and dimensions). Untick to create only the table."/>
                <ComboBox x:Name="cmbViews" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="View name"/>
                <TextBox x:Name="txtViewName" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Padding="4"
                         ToolTip="The name of the one view that holds all selected trays"/>

                <!-- the cable table of all trays, in a view of its own with its own scale and text style -->
                <CheckBox x:Name="chkTable" Grid.Row="9" Grid.Column="0" Margin="0,10,10,0" VerticalAlignment="Center"
                          Content="Cable table view"
                          ToolTip="Also creates one view with the table CABLE TAG | FED FROM | FED TO | CABLE of all selected trays"/>
                <Grid Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="170"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbTableLayout" Grid.Column="5" Margin="10,0,0,0"
                              ToolTip="A separate small table for each tray (as under each tray drawing), or one table for all trays"/>
                    <TextBox x:Name="txtTableName" Grid.Column="0" Padding="4" ToolTip="The name of the table view"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="12,0,6,0" Text="Scale"/>
                    <ComboBox x:Name="cmbTableScale" Grid.Column="2" ToolTip="The scale of the table view (independent of the tray views)"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Margin="12,0,6,0" Text="Text"/>
                    <ComboBox x:Name="cmbTableText" Grid.Column="4" ToolTip="The text style of the table (a text type of this project)"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="If the view exists"/>
                <ComboBox x:Name="cmbExisting" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="View scale"/>
                <ComboBox x:Name="cmbScale" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"
                          ToolTip="The scale of the drafting views"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="Text style"/>
                <ComboBox x:Name="cmbTextType" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"
                          ToolTip="A text type of this project. No text types are created."/>

                <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,8,10,0" Text="Dimension style"/>
                <ComboBox x:Name="cmbDimType" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"
                          ToolTip="A linear dimension type of this project. The dimensions in the view are real Revit dimensions of this type."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <CheckBox x:Name="chkAll" DockPanel.Dock="Left" Content="Select all trays that can be drawn"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCount" HorizontalAlignment="Right" Foreground="#5A6270"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="22,0,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Tray ID"/>
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" TextAlignment="Right" Text="Cables"/>
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" TextAlignment="Right" Text="Layers"/>
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" TextAlignment="Right" Text="Layout mm"/>
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" TextAlignment="Right" Text="Required mm"/>
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" TextAlignment="Right" Text="Tray mm"/>
                    <TextBlock Grid.Column="6" FontWeight="SemiBold" Margin="14,0,0,0" Text="Result"/>
                </Grid>
                <Border Grid.Row="2" BorderBrush="#DDE1E6" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelTrays" Margin="4"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <TextBox x:Name="txtMessages" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" Padding="8"
                 VerticalScrollBarVisibility="Auto" BorderBrush="#DDE1E6" FontFamily="Consolas" FontSize="12"
                 Text="Choose the cable schedule file to begin."/>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnCreate" Content="Create views" IsEnabled="False" FontWeight="SemiBold"/>
                <Button x:Name="btnClose" Content="Close" IsCancel="True"/>
            </StackPanel>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Foreground="#5A6270" TextTrimming="CharacterEllipsis"
                       Text="required width = cable layout width x 1.20 (20% future space)"/>
        </DockPanel>
    </Grid>
</Window>
