<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Earthing Route Generator" Width="1120" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#EEF6F1" FontFamily="Segoe UI" FontSize="12" ShowInTaskbar="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Green" Color="#12A150"/>
    <SolidColorBrush x:Key="Blue" Color="#1E88E5"/>
    <SolidColorBrush x:Key="Ink" Color="#16302B"/>
    <SolidColorBrush x:Key="Muted" Color="#5E7A70"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#0E7A3D"/>
      <Setter Property="BorderBrush" Value="#7CCB9C"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" RecognizesAccessKey="False"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="BlueBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C8E3D4"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Green}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Picked" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="Group" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="26"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="4,0"/>
      <Setter Property="BorderBrush" Value="#9AD3B4"/>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border Grid.Row="0" CornerRadius="10" Padding="18,12" Margin="0,0,0,10">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#0B7A3B" Offset="0"/>
          <GradientStop Color="#12A150" Offset="0.6"/>
          <GradientStop Color="#C9B100" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <TextBlock x:Name="view_tb" DockPanel.Dock="Right" Foreground="White" VerticalAlignment="Center" TextAlignment="Right"/>
        <StackPanel>
          <TextBlock Text="EARTHING ROUTE GENERATOR" Foreground="White" FontSize="20" FontWeight="Bold"/>
          <TextBlock Foreground="#E8FFF1" Margin="0,2,0,0"
                     Text="Draws 2D earthing lines in the active floor plan, from the panels to the earth bar, round columns and MEP. Detail lines only."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="470"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ============ left: what to route and how ============ -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,4,0">
          <Border Style="{StaticResource Card}" BorderBrush="#12A150" BorderThickness="1.5">
            <StackPanel>
              <TextBlock Text="WHAT TO DRAW" Style="{StaticResource Head}"/>
              <ComboBox x:Name="task_cb" Height="28" VerticalContentAlignment="Center" FontWeight="SemiBold"
                        ToolTip="Panels to an earth bar: one line from every selected panel to the earth bar.  Earth bars to an earth pit / exit point: one line from every selected earth bar to the pit, or to a point you click outside the room.  Earth bar loop: the selected earth bars connected to each other in a ring."/>
            </StackPanel>
          </Border>

          <Border x:Name="bar_card" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="bar_head" Text="1   EARTH BAR" Style="{StaticResource Head}"/>
              <Button x:Name="btn_bar" Content="Select Earth Bar" Style="{StaticResource BlueBtn}"/>
              <Button x:Name="btn_point" Content="...or click an exit point in the plan" Margin="0,6,0,0" Visibility="Collapsed"
                      ToolTip="Click where the lines leave the room (e.g. just outside the wall, towards the earth pit). The lines end at that point."/>
              <TextBlock x:Name="bar_tb" Style="{StaticResource Picked}" Text="Not selected"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="panels_head" Text="2   PANELS" Style="{StaticResource Head}"/>
              <Button x:Name="btn_panels" Content="Select Panels" Style="{StaticResource BlueBtn}"/>
              <TextBlock x:Name="panels_tb" Style="{StaticResource Picked}" Text="None selected"/>
              <CheckBox x:Name="chk_close" Margin="0,8,0,0" Visibility="Collapsed"
                        ToolTip="On: the last earth bar is connected back to the first, so the bars form a closed ring. Off: a chain from the first bar to the last.">
                <TextBlock Text="Close the loop (last earth bar back to the first)"/>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="3   LINE STYLE, CLEARANCE, GRID" Style="{StaticResource Head}"/>
              <ComboBox x:Name="style_cb" Height="26" VerticalContentAlignment="Center"
                        ToolTip="An existing line style of the project. No line style is created."/>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Obstacle clearance (mm)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                  <TextBox x:Name="clearance_tb" Text="100"
                           ToolTip="The line never comes closer than this to an obstacle."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Grid spacing (mm)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                  <ComboBox x:Name="grid_cb" Height="26" IsEditable="True" VerticalContentAlignment="Center"
                            ToolTip="Pick a value or type your own. Smaller = finer routes but slower."/>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="chk_edge" Margin="0,10,0,0"
                        ToolTip="On: each line starts on the edge of the panel and ends on the edge of the earth bar. Off: it runs to their centre (or electrical connector).">
                <TextBlock Text="Start and end the lines at the EDGE of the panel / earth bar"/>
              </CheckBox>
              <CheckBox x:Name="chk_entry" Margin="0,6,0,0"
                        ToolTip="On: every line turns in front of the earth bar and enters it square to its long side, each on its own spot, from the side the panels are on. Off: a line meets the bar from whichever direction its route arrives.">
                <TextBlock Text="Enter / leave an earth bar square to its long side, each line on its own spot"/>
              </CheckBox>
              <CheckBox x:Name="chk_breaks" Margin="0,6,0,0"
                        ToolTip="Where a line has to cross other earthing lines it stops short of them with a break mark and starts again behind them; the crossed lines stay whole. Off: the lines simply cross.">
                <TextBlock Text="Break a line where it crosses other earthing lines (break mark on both sides)"/>
              </CheckBox>
              <CheckBox x:Name="chk_square" Margin="0,6,0,0"
                        ToolTip="On: the lines run square to the earth bar - in a room turned on the drawing they follow the room and its equipment. Off: the lines are horizontal and vertical on the drawing.">
                <TextBlock Text="Lines square to the earth bar (follow a room turned on the drawing)"/>
              </CheckBox>
              <CheckBox x:Name="chk_room" Margin="0,6,0,0"
                        ToolTip="The boundary of the room the earth bar and panels stand in (from this model or a linked model) is a wall the lines do not cross: they stay inside the room.">
                <TextBlock Text="Keep the lines inside the room (its boundary, also from a linked model)"/>
              </CheckBox>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="12"/><ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Where lines take the same way" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                  <ComboBox x:Name="share_cb" Height="26" VerticalContentAlignment="Center"
                            ToolTip="Side by side: every panel keeps its own line; where lines run the same way they are drawn next to each other at the offset. One line with tees: a shared stretch is drawn once and the other panels tee into it. On top of each other: every panel its own line, no offset."/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Offset (mm)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                  <TextBox x:Name="offset_tb" Text="100"
                           ToolTip="Distance between parallel earthing lines. Rounded up to a whole number of grid cells."/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="Bend radius (mm)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
                  <TextBox x:Name="bend_tb" Text="150"
                           ToolTip="Every square corner of a line is drawn as a bend (an arc) of this radius. 0 = sharp corners. Two corners close together each get a smaller bend so they do not overlap."/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button x:Name="btn_all" Content="All" Height="22" FontSize="11" Margin="0,0,4,0"/>
                  <Button x:Name="btn_none" Content="None" Height="22" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="4   OBSTACLES TO AVOID" Style="{StaticResource Head}" Margin="0" VerticalAlignment="Center"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Structural" Style="{StaticResource Group}"/>
                  <StackPanel x:Name="obs_structural"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Mechanical" Style="{StaticResource Group}"/>
                  <StackPanel x:Name="obs_mechanical"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Electrical" Style="{StaticResource Group}"/>
                  <StackPanel x:Name="obs_electrical"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="#D6EBDF" Margin="0,8"/>
              <CheckBox x:Name="chk_links" Margin="0,0,0,4"
                        ToolTip="Obstacles in the loaded Revit links are used too, in their true position.">
                <TextBlock Text="Include linked models" FontWeight="SemiBold"/>
              </CheckBox>
              <CheckBox x:Name="chk_doors"
                        ToolTip="On: a door is an opening in its wall, so a route can go from room to room. Off: walls are solid.">
                <TextBlock Text="Let routes pass through door openings"/>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ right: result ============ -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="1.2*"/>
          <RowDefinition Height="10"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="grid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E1EFE7" RowHeight="26"
                  BorderBrush="#C8E3D4" Background="White" CanUserAddRows="False" SelectionMode="Single">
          <DataGrid.ColumnHeaderStyle>
            <Style TargetType="DataGridColumnHeader">
              <Setter Property="Background" Value="#14532D"/>
              <Setter Property="Foreground" Value="White"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Padding" Value="8,6"/>
            </Style>
          </DataGrid.ColumnHeaderStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="PANEL" Binding="{Binding Panel}" Width="1.3*"/>
            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="150">
              <DataGridTextColumn.CellStyle>
                <Style TargetType="DataGridCell">
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="ok">
                      <Setter Property="Background" Value="#C6EFCE"/><Setter Property="Foreground" Value="#006100"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="warn">
                      <Setter Property="Background" Value="#FFEB9C"/><Setter Property="Foreground" Value="#7F6000"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="fail">
                      <Setter Property="Background" Value="#FFC7CE"/><Setter Property="Foreground" Value="#9C0006"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.CellStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="LENGTH (m)" Binding="{Binding Length}" Width="84"/>
            <DataGridTextColumn Header="BENDS" Binding="{Binding Bends}" Width="58"/>
            <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="2.4*"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBox x:Name="report_tb" Grid.Row="2" Height="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 VerticalContentAlignment="Top" Padding="8,6" Background="#F7FCF9" BorderBrush="#C8E3D4"
                 Text="EARTHING ROUTE REPORT&#x0a;&#x0a;Select the earth bar and the panels, then click Preview Routes."/>
      </Grid>
    </Grid>

    <!-- actions -->
    <DockPanel Grid.Row="2" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="btn_preview" Content="Preview Routes" Style="{StaticResource BlueBtn}" Width="140" Margin="0,0,8,0"
                ToolTip="Calculates the routes and shows them as temporary magenta lines. Nothing permanent is drawn."/>
        <Button x:Name="btn_clear" Content="Clear Preview" Width="120" Margin="0,0,8,0"/>
        <Button x:Name="btn_create" Content="Create Routes" Style="{StaticResource GreenBtn}" Width="140" Margin="0,0,8,0"
                ToolTip="Draws the routes as detail lines in the chosen line style."/>
        <Button x:Name="btn_cancel" Content="Cancel" Width="90"/>
      </StackPanel>
      <TextBlock x:Name="status_tb" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#14532D" Margin="0,0,12,0"/>
    </DockPanel>
  </Grid>
</Window>
