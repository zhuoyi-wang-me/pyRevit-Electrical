<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Element Search" Height="720" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#F3F4F6">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: title -->
            <RowDefinition Height="Auto"/>
            <!-- 1: templates bar -->
            <RowDefinition Height="10"/>
            <!-- 2: spacer -->
            <RowDefinition Height="Auto"/>
            <!-- 3: filter row -->
            <RowDefinition Height="12"/>
            <!-- 4: spacer -->
            <RowDefinition Height="*"/>
            <!-- 5: results -->
            <RowDefinition Height="Auto"/>
            <!-- 6: action buttons -->
            <RowDefinition Height="Auto"/>
            <!-- 7: status -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="MEP Element Search"
                   FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>

        <!-- Templates bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Saved Template" VerticalAlignment="Center" Margin="0"/>

                <ComboBox Grid.Column="2" x:Name="cmbTemplates" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="btnLoadTemplate" Content="Load" Click="btnLoadTemplate_click" Width="70"/>
                    <Button x:Name="btnSaveTemplate" Content="Save As Template..." Click="btnSaveTemplate_click" Width="150" Background="#059669"/>
                    <Button x:Name="btnLoadLastTemplate" Content="Import Last Saved" Click="btnLoadLastTemplate_click" Width="140" Background="#6B7280"/>
                    <Button x:Name="btnDeleteTemplate" Content="Delete" Click="btnDeleteTemplate_click" Width="70" Background="#DC2626" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter row -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="14" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Category"/>
                    <ComboBox x:Name="cmbCategory" SelectionChanged="cmbCategory_change"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Parameter"/>
                    <ComboBox x:Name="cmbParameter" IsEditable="True"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <Label Content="Condition"/>
                    <ComboBox x:Name="cmbOperator"/>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <Label Content="Value"/>
                    <TextBox x:Name="txtValue"/>
                </StackPanel>

                <StackPanel Grid.Column="8" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <CheckBox x:Name="chkCaseSensitive" Content="Case sensitive" VerticalAlignment="Center" Margin="0,0,12,6" FontSize="11"/>
                    <Button x:Name="btnSearch" Content="Search" Click="btnSearch_click" Width="90"/>
                    <Button x:Name="btnForgetSettings" Content="Forget Saved" Click="btnForgetSettings_click" Width="100" Background="#9CA3AF" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results -->
        <Border Grid.Row="5" Background="White" CornerRadius="6" BorderBrush="#E5E7EB" BorderThickness="1">
            <DataGrid x:Name="dgResults" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeaderWidth="0" Margin="4"
                      AlternatingRowBackground="#F9FAFB" BorderThickness="0"
                      CanUserSortColumns="True" CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
                    <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="180"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="180"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="110"/>
                    <DataGridTextColumn Header="Parameter" Binding="{Binding ParamName}" Width="150"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Action buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="btnSelect" Content="Select in Model" Click="btnSelect_click"/>
            <Button x:Name="btnShow" Content="Zoom To" Click="btnShow_click"/>
            <Button x:Name="btnIsolate" Content="Isolate in View" Click="btnIsolate_click"/>
            <Button x:Name="btnClearIsolate" Content="Clear Isolate" Click="btnClearIsolate_click" Background="#6B7280"/>
            <Button x:Name="btnExport" Content="Export CSV" Click="btnExport_click" Background="#059669"/>
            <Button x:Name="btnClear" Content="Clear Results" Click="btnClear_click" Background="#9CA3AF"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock Grid.Row="7" x:Name="lblStatus" Margin="0,10,0,0" FontSize="11" Foreground="#4B5563"
                   Text="Select a category to begin."/>
    </Grid>
</Window>
