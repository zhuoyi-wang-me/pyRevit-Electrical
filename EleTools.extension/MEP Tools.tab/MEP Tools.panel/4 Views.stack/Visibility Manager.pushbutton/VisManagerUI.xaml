<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Visibility Manager"
    Height="880" Width="1400" MinHeight="650" MinWidth="1150"
    WindowStartupLocation="CenterScreen"
    Background="#F2F4F6"
    FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Padding" Value="22,6,6,6"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
        </Style>
        <Style x:Key="TypeChip" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,14,4"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="FooterCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="BigActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Border Grid.Row="0" Background="#BFE3F5" CornerRadius="5" Padding="18,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Copy / Remove Filters &amp; Visibility/Graphics Overrides"
                               FontSize="19" FontWeight="Bold" Foreground="#123" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtHeaderSubtitle" Text="Choose filters/V-G overrides from current view and apply to selected targets"
                               FontSize="11.5" FontStyle="Italic" Foreground="#345" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="v1.0" Foreground="#456" FontSize="10" VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ===================== 3 COLUMNS ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ COLUMN 1: MODE + SOURCE ============ -->
            <Border Grid.Column="0" Background="White" CornerRadius="5" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1565C0">
                            <TextBlock Text="1" Style="{StaticResource BadgeText}"/>
                        </Border>
                        <TextBlock Text="  Select Operation Mode" Style="{StaticResource ColumnTitle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="4" Padding="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="radModeFilters" Grid.Column="0" Content="Filters" IsChecked="True"
                                         GroupName="mode" HorizontalAlignment="Center" Margin="4" Checked="OnModeFiltersClick"/>
                            <RadioButton x:Name="radModeVG" Grid.Column="1" Content="V/G Overrides"
                                         GroupName="mode" HorizontalAlignment="Center" Margin="4" Checked="OnModeVGClick"/>
                            <RadioButton x:Name="radModeLinks" Grid.Column="2" Content="Revit Links"
                                         GroupName="mode" HorizontalAlignment="Center" Margin="4" Checked="OnModeLinksClick"/>
                            <RadioButton x:Name="radModeWorksets" Grid.Column="3" Content="Worksets"
                                         GroupName="mode" HorizontalAlignment="Center" Margin="4" Checked="OnModeWorksetsClick"/>
                        </Grid>
                    </Border>

                    <Border x:Name="borderModeBanner" Grid.Row="2" Background="#DDF3DD" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="txtModeBannerTitle" Text="Filters Mode" FontWeight="Bold" Foreground="#2E7D32" FontSize="12"/>
                            <TextBlock x:Name="txtModeBannerBody" TextWrapping="Wrap" FontSize="11" Foreground="#2E7D32" Margin="0,2,0,0"
                                       Text="Select filters from current view to copy/remove to selected targets [2] &amp; [3]"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="txtSourceSearch" Grid.Row="3" Style="{StaticResource SearchBox}" TextChanged="OnSourceSearchChanged"/>

                    <CheckBox x:Name="chkSourceSelectAll" Grid.Row="4" Content="Select All" IsChecked="True" Margin="0,0,0,4" Click="OnSourceSelectAllClick"/>

                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stkSourceItems"/>
                    </ScrollViewer>

                    <TextBlock x:Name="txtSourceCount" Grid.Row="7" HorizontalAlignment="Center" Foreground="#555" FontSize="11.5"
                               Margin="0,8,0,0" Text="0 filters selected"/>
                </Grid>
            </Border>

            <!-- ============ COLUMN 2: TARGET VIEWS ============ -->
            <Border Grid.Column="2" Background="White" CornerRadius="5" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1565C0">
                            <TextBlock Text="2" Style="{StaticResource BadgeText}"/>
                        </Border>
                        <TextBlock Text="  Choose Target Views" Style="{StaticResource ColumnTitle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="View Types:" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <CheckBox x:Name="chkV3D" Style="{StaticResource TypeChip}" Content="3D Views" IsChecked="True" Click="OnViewTypeFilterChanged"/>
                            <CheckBox x:Name="chkVFloor" Style="{StaticResource TypeChip}" Content="Floor Plans" IsChecked="True" Click="OnViewTypeFilterChanged"/>
                            <CheckBox x:Name="chkVSection" Style="{StaticResource TypeChip}" Content="Sections" IsChecked="True" Click="OnViewTypeFilterChanged"/>
                            <CheckBox x:Name="chkVCeiling" Style="{StaticResource TypeChip}" Content="Ceiling Plans" IsChecked="True" Click="OnViewTypeFilterChanged"/>
                            <CheckBox x:Name="chkVElevation" Style="{StaticResource TypeChip}" Content="Elevations" IsChecked="True" Click="OnViewTypeFilterChanged"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBox x:Name="txtViewSearch" Grid.Row="2" Style="{StaticResource SearchBox}" TextChanged="OnViewSearchChanged"/>

                    <CheckBox x:Name="chkViewsSelectAll" Grid.Row="3" Content="Select All" IsChecked="True" Margin="0,0,0,4" Click="OnViewsSelectAllClick"/>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stkViewItems"/>
                    </ScrollViewer>

                    <TextBlock x:Name="txtViewCount" Grid.Row="5" HorizontalAlignment="Center" Foreground="#555" FontSize="11.5"
                               Margin="0,8,0,0" Text="0 views selected"/>
                </Grid>
            </Border>

            <!-- ============ COLUMN 3: TARGET TEMPLATES ============ -->
            <Border Grid.Column="4" Background="White" CornerRadius="5" Padding="14" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#1565C0">
                            <TextBlock Text="3" Style="{StaticResource BadgeText}"/>
                        </Border>
                        <TextBlock Text="  Choose Target Templates" Style="{StaticResource ColumnTitle}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Template Types:" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                        <WrapPanel>
                            <CheckBox x:Name="chkT3D" Style="{StaticResource TypeChip}" Content="3D Views" IsChecked="True" Click="OnTemplateTypeFilterChanged"/>
                            <CheckBox x:Name="chkTFloor" Style="{StaticResource TypeChip}" Content="Floor Plans" IsChecked="True" Click="OnTemplateTypeFilterChanged"/>
                            <CheckBox x:Name="chkTSection" Style="{StaticResource TypeChip}" Content="Sections" IsChecked="True" Click="OnTemplateTypeFilterChanged"/>
                            <CheckBox x:Name="chkTCeiling" Style="{StaticResource TypeChip}" Content="Ceiling Plans" IsChecked="True" Click="OnTemplateTypeFilterChanged"/>
                            <CheckBox x:Name="chkTElevation" Style="{StaticResource TypeChip}" Content="Elevations" IsChecked="True" Click="OnTemplateTypeFilterChanged"/>
                        </WrapPanel>
                    </StackPanel>

                    <TextBox x:Name="txtTemplateSearch" Grid.Row="2" Style="{StaticResource SearchBox}" TextChanged="OnTemplateSearchChanged"/>

                    <CheckBox x:Name="chkTemplatesSelectAll" Grid.Row="3" Content="Select All" IsChecked="True" Margin="0,0,0,4" Click="OnTemplatesSelectAllClick"/>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="stkTemplateItems"/>
                    </ScrollViewer>

                    <TextBlock x:Name="txtTemplateCount" Grid.Row="5" HorizontalAlignment="Center" Foreground="#555" FontSize="11.5"
                               Margin="0,8,0,0" Text="0 templates selected"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== FOOTER ===================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock x:Name="txtExportCaption" Style="{StaticResource FooterCaption}" Text="Export current view Filters"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnExportCsv" Content="EXPORT (CSV)" Style="{StaticResource SmallActionBtn}" Click="OnExportCsvClick"/>
                        <Button x:Name="btnExportXlsx" Content="XLSX" Style="{StaticResource SmallActionBtn}" Click="OnExportXlsxClick"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="txtImportCaption" Style="{StaticResource FooterCaption}" Text="Import Filters to current view"/>
                    <Button x:Name="btnImport" Content="IMPORT" Style="{StaticResource SmallActionBtn}" Click="OnImportClick"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="txtStatus" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666" FontSize="11.5" Text="Ready."/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Style="{StaticResource FooterCaption}" Text="Copy to selected targets"/>
                    <Button x:Name="btnCopy" Content="COPY" Style="{StaticResource BigActionBtn}" Background="#2E7D32" Click="OnCopyClick"/>
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Style="{StaticResource FooterCaption}" Text="Remove from selected"/>
                    <Button x:Name="btnRemove" Content="REMOVE" Style="{StaticResource BigActionBtn}" Background="#B71C1C" Click="OnRemoveClick"/>
                </StackPanel>
                <Button Content="CANCEL" Style="{StaticResource BigActionBtn}" Background="#888" Margin="14,17,0,0" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
