<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Linked Rooms — 3D Views" Height="560" Width="680"
        MinHeight="420" MinWidth="560" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Linked model:" />
    <ComboBox x:Name="linkCombo" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" MinHeight="26" DisplayMemberPath="Name" />

    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="Search rooms:" />
    <TextBox x:Name="searchText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" MinHeight="26" ToolTip="Filter by room number, name, or level" />

    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Text="View prefix:" />
    <TextBox x:Name="prefixText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" MinHeight="26" Text="ROOM 3D - " />

    <ListView x:Name="roomsList" Grid.Row="3" Grid.ColumnSpan="2" SelectionMode="Extended" BorderBrush="#999" BorderThickness="1">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Room number" DisplayMemberBinding="{Binding Number}" Width="120" />
          <GridViewColumn Header="Room name" DisplayMemberBinding="{Binding Name}" Width="280" />
          <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="190" />
        </GridView>
      </ListView.View>
    </ListView>

    <TextBlock x:Name="statusText" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,10" TextWrapping="Wrap" Foreground="#555" />
    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="refreshButton" Width="100" Margin="0,0,8,0" Padding="8,4" Content="Refresh rooms" />
      <Button x:Name="createButton" Width="130" Margin="0,0,8,0" Padding="8,4" Content="Create 3D views" />
      <Button x:Name="closeButton" Width="80" Padding="8,4" Content="Close" />
    </StackPanel>
  </Grid>
</Window>
