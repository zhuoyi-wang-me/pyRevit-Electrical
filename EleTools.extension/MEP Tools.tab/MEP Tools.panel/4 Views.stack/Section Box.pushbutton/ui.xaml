<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Section Box" Height="330" Width="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="2,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="2,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="3D SECTION BOX" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <RadioButton x:Name="radio_in_model" Content="In model" GroupName="selMode" IsChecked="True" Margin="2,6,20,6"/>
            <RadioButton x:Name="radio_in_link" Content="In link" GroupName="selMode" Margin="2,6"/>
        </StackPanel>

        <CheckBox Grid.Row="2" x:Name="chk_manual_orientation" Content="Manual orientation"/>

        <TextBlock Grid.Row="3" Text="Offset" Margin="2,10,0,2" FontWeight="SemiBold"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="slider_offset" Grid.Column="0" Minimum="0" Maximum="100"
                    Value="0" TickFrequency="5" IsSnapToTickEnabled="False"
                    VerticalAlignment="Center" Margin="2,0,8,0"
                    ValueChanged="slider_offset_ValueChanged"/>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn_minus" Grid.Column="0" Content="-" Width="20" Padding="0" Click="btn_minus_Click"/>
                <TextBox x:Name="txt_offset" Grid.Column="1" Text="0" TextAlignment="Center"
                         VerticalContentAlignment="Center" Margin="2,0"
                         TextChanged="txt_offset_TextChanged"/>
                <Button x:Name="btn_plus" Grid.Column="2" Content="+" Width="20" Padding="0" Click="btn_plus_Click"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="5" Text="%" HorizontalAlignment="Right" Margin="0,0,4,0"/>

        <CheckBox Grid.Row="6" x:Name="chk_section_box" Content="Section Box" IsChecked="True"/>

        <Button Grid.Row="7" x:Name="btn_select" Content="Select elements"
                VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Height="34" Margin="2,10,2,2" Click="btn_select_Click"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btn_cancel" Content="Cancel" Width="80" Click="btn_cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
