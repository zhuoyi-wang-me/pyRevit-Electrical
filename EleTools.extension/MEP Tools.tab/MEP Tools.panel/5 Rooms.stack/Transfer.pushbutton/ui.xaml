<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Equipment Parameter Transfer" Height="760" Width="820"
        MinHeight="650" MinWidth="700" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#F3F5F7" FontFamily="Segoe UI" FontSize="13">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#17324D" CornerRadius="8" Padding="16" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Equipment Parameter Transfer" FontSize="21" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="Copy values from Mechanical Equipment to connected duct network targets." Foreground="#DCE7F1" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Background="White" BorderBrush="#D8DEE5" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="Parameter mappings" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="+ Add mapping" Width="112" Height="30" Click="add_mapping_click" Background="#E8F1FA" BorderBrush="#B8CDE0"/>
            </DockPanel>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
              <TextBlock Text="SOURCE PARAMETER" Foreground="#657383" FontSize="10" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" Text="TARGET PARAMETER" Foreground="#657383" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
              <TextBlock Grid.Column="2" Text="TARGET CATEGORY" Foreground="#657383" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
            </Grid>
            <Border Background="#F8FAFC" BorderBrush="#E2E7EC" BorderThickness="1" CornerRadius="4" Padding="6" MaxHeight="250">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="mappingPanel"/></ScrollViewer>
            </Border>
            <TextBlock Text="Parameter boxes suggest names found in the current model and still accept custom names. Use GUID: followed by a shared parameter GUID when names are ambiguous." TextWrapping="Wrap" Foreground="#657383" FontSize="11" Margin="0,7,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#D8DEE5" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Traversal" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,7">
              <TextBlock Text="Maximum depth" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox x:Name="maxDepthBox" Text="100" Width="55" Padding="5"/>
              <TextBlock Text="0 = stop at equipment, -1 = unlimited" Foreground="#657383" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel>
              <CheckBox x:Name="includeBranchesBox" Content="Include branches" IsChecked="True" Margin="0,3,20,3"/>
              <CheckBox x:Name="stopEquipmentBox" Content="Stop at other Mechanical Equipment" IsChecked="True" Margin="0,3,20,3"/>
              <CheckBox x:Name="stopSystemsBox" Content="Stop at assigned system boundaries" Margin="0,3,0,3"/>
            </WrapPanel>
            <CheckBox x:Name="processLinksBox" Content="Include linked models (linked targets are reported read-only)" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#D8DEE5" BorderThickness="1" CornerRadius="6" Padding="13">
          <StackPanel>
            <TextBlock Text="Safety and execution" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/>
            <CheckBox x:Name="categoryAccessoriesBox" Content="Allow Duct Accessories" IsChecked="True" Margin="0,2"/>
            <CheckBox x:Name="categoryTerminalsBox" Content="Allow Air Terminals" IsChecked="True" Margin="0,2"/>
            <CheckBox x:Name="dryRunBox" Content="Dry run" IsChecked="True" Checked="dryrun_changed" Unchecked="dryrun_changed" FontWeight="SemiBold" Foreground="#145A32" Margin="0,8,0,0"/>
            <TextBlock x:Name="executionModeText" Text="PREVIEW ONLY — no model changes will be made" Foreground="#145A32" FontWeight="Bold" Margin="20,3,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,12,0,0">
      <TextBlock Text="Physical HVAC connector traversal · changes are undoable in Revit" Foreground="#657383" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="90" Height="34" Margin="0,0,8,0" Click="cancel_click"/>
        <Button x:Name="executeButton" Content="Preview only" Width="140" Height="34" IsDefault="True" Click="execute_click" Background="#176B46" Foreground="White" BorderBrush="#145A3B"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>

