<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Export Manager"
    Width="1320"
    Height="840"
    MinWidth="1080"
    MinHeight="640"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen"
    Background="#FFF2F4F7"
    Foreground="#FF1D2733"
    FontFamily="Segoe UI"
    FontSize="12.5"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <!--
        Modeless window (see ui.py).  Every Name= below is looked up from
        Python, so keep the names when restyling.  ui.py also reads the
        dgItems column HEADERS ("Number / Type", "Level", "On Sheet",
        "Filter Values") to show/hide columns per mode - keep those strings.

        Icons are glyphs from the "Segoe MDL2 Assets" font that ships with
        Windows 10/11, passed to buttons through their Tag property.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ============================ Palette ============================ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0B6BCB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF0958A8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF074785" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE8F1FC" />
        <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#FFBBD6F5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1D2733" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF667585" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFDCE2E9" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#FFB9C3CE" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FFF6F8FA" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FFEEF2F6" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE6EAEF" />
        <SolidColorBrush x:Key="GoBrush" Color="#FF16845B" />
        <SolidColorBrush x:Key="GoHoverBrush" Color="#FF116D4A" />
        <SolidColorBrush x:Key="GoPressedBrush" Color="#FF0C573B" />

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0F2A47" Offset="0" />
            <GradientStop Color="#FF1A4D7C" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ============================ Text ============================== -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ============================ Cards ============================= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- Rounded shell for a text box that carries an icon / clear button -->
        <Style x:Key="InputShell" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ Buttons =========================== -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="label"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="icon" Property="Margin" Value="0" />
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <!-- Filled blue: the main action of a panel -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled green: EXPORT -->
        <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GoBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="15"
                                           Margin="0,1,10,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF8A97A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent button for the dark header band -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless square icon button (clear search etc.) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- Toggle button (Edit naming rule): looks like a normal button,
             turns soft-blue while switched on. Icon via Tag. -->
        <Style x:Key="ToggleAction" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <TextBlock x:Name="chev"
                                           Style="{StaticResource Glyph}"
                                           FontSize="9"
                                           Margin="8,1,0,0"
                                           Text="&#xE70D;" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="chev" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grey placeholder text laid over an empty text box (Tag = the TextBox) -->
        <Style x:Key="Watermark" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9AA6B2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Centred message shown over an empty list (Tag = the list) -->
        <Style x:Key="EmptyState" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.HasItems, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hint line that takes no space until ui.py writes text into it -->
        <Style x:Key="StatusHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ Text boxes ======================== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text box with no chrome: lives inside an InputShell border -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Check / radio ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#FF94A1AE"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Path x:Name="tick"
                                          Data="M2.5,7 L5.8,10.2 L11.5,3.8"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                    <Rectangle x:Name="dash"
                                               Width="8"
                                               Height="2"
                                               Fill="White"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="17" Height="17" VerticalAlignment="Center">
                                <Ellipse x:Name="ring"
                                         Fill="White"
                                         Stroke="#FF94A1AE"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="dot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button drawn as one segment of a segmented switch -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Combo box ========================= -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,1,11,0"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Stroke="#FF667585"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF667585" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0B6BCB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="White"
                                        BorderBrush="{StaticResource LineStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer Margin="0,3">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ List box ========================== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer Margin="0,2" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Data grid ========================= -->
        <Style x:Key="ColumnGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Path x:Name="sort"
                                          Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="M0,4 L4,0 L8,4"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.6"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource ColumnGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripper}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                                <Setter TargetName="sort" Property="Data" Value="M0,0 L4,4 L8,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFAFBFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEDF0F3" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <!-- ============================ Cards as GroupBox / Expander ====== -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border x:Name="bd"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,14">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"
                                                  ContentSource="Header"
                                                  Margin="0,0,0,8"
                                                  TextElement.FontSize="13.5"
                                                  TextElement.FontWeight="SemiBold" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10,14,14">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent" Height="24">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.FontSize="13.5"
                                                                  TextElement.FontWeight="SemiBold" />
                                                <Path x:Name="chevron"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,2,0"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#FF667585"
                                                      StrokeThickness="1.6" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chevron" Property="Data" Value="M0,4 L4,0 L8,4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Wizard steps ====================== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Height="50" Margin="0,0,26,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="badge"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{StaticResource TrackBrush}">
                                    <TextBlock x:Name="badgeText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="9,0,0,0"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="line"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="White" />
                                <Setter TargetName="line" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal"
                                            IsItemsHost="True"
                                            Margin="20,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- ProSheets-style format toggle: an icon button that lights up when the format is on.
             Still a CheckBox, so chkPDF / chkDWG keep IsChecked and Click for ui.py. -->
        <Style x:Key="FormatToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="shell"
                                Background="White"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5"
                                MinWidth="74">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="glyph"
                                           Style="{StaticResource Glyph}"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="16"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                                <TextBlock x:Name="tick"
                                           Style="{StaticResource Glyph}"
                                           Text="&#xE73E;"
                                           FontSize="11"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================
             Header band
             ================================================================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel>
                <Button Name="btnRefresh"
                        DockPanel.Dock="Right"
                        Style="{StaticResource HeaderButton}"
                        Tag="&#xE72C;"
                        Content="Refresh from model"
                        VerticalAlignment="Center"
                        ToolTip="Re-read sheets and views from Revit. Use after adding, renaming or deleting views/sheets while this window is open. Your ticks are kept." />
                <!-- Same drawing as the ribbon icon.png (sheet + green export badge) -->
                <Border Width="40"
                        Height="40"
                        CornerRadius="9"
                        Background="#26FFFFFF"
                        VerticalAlignment="Center">
                    <Viewbox Width="30" Height="30">
                        <Canvas Width="96" Height="96">
                            <Path Data="M14,8 L64,8 L80,24 L80,88 L14,88 Z" Fill="White" Stroke="#FF2E3D4F" StrokeThickness="5" StrokeLineJoin="Round" />
                            <Path Data="M64,8 L64,24 L80,24" Stroke="#FF2E3D4F" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Rectangle Canvas.Left="24" Canvas.Top="30" Width="20" Height="16" RadiusX="2" RadiusY="2" Fill="#FFE3EEFB" Stroke="#FF0B6BCB" StrokeThickness="3" />
                            <Rectangle Canvas.Left="50" Canvas.Top="30" Width="20" Height="16" RadiusX="2" RadiusY="2" Fill="#FFE3EEFB" Stroke="#FF0B6BCB" StrokeThickness="3" />
                            <Path Data="M25,58 L46,58 M25,68 L40,68" Stroke="#FF9AA6B2" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="46" Canvas.Top="50" Width="46" Height="46" Fill="#FF16845B" Stroke="White" StrokeThickness="4" />
                            <Path Data="M60,82 L79,63 M66,62 L80,62 L80,76" Stroke="White" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Export Manager"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Name="txtDocName"
                               Text="Sheets and views to PDF and DWG"
                               Foreground="#FFC3D5E8"
                               FontSize="12"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Name="tabMain" Grid.Row="1">

            <!-- ============================================================
                 1. Selection
                 ============================================================ -->
            <TabItem Header="Selection" Tag="1">
                <Grid Margin="16,14,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ............ Left: what to list and how to narrow it ............ -->
                    <ScrollViewer Grid.Column="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,10,0"
                                  Padding="0,0,4,0">
                        <StackPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Export source" />
                                    <Border Style="{StaticResource SegmentTrack}" Margin="0,9,0,0">
                                        <UniformGrid Rows="1">
                                            <RadioButton Name="rbSheets"
                                                         Style="{StaticResource Segment}"
                                                         Tag="&#xE7C3;"
                                                         Content="Sheets"
                                                         GroupName="ExportSource"
                                                         IsChecked="True" />
                                            <RadioButton Name="rbViews"
                                                         Style="{StaticResource Segment}"
                                                         Tag="&#xE890;"
                                                         Content="Views"
                                                         GroupName="ExportSource" />
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Tick what is selected in Revit's Project Browser -->
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="From Project Browser" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,3,0,9"
                                               TextWrapping="Wrap"
                                               Text="Select sheets or views in the Project Browser, then tick them here in one click." />
                                    <Button Name="btnFromBrowser"
                                            Tag="&#xE8B3;"
                                            Content="Tick Project Browser selection"
                                            Height="32"
                                            ToolTip="Reads the current Revit selection (Project Browser, Ctrl / Shift for several) and ticks those rows; all other rows are unticked. Switches Sheets / Views mode if needed." />
                                    <TextBlock Name="txtBrowserPick"
                                               Style="{StaticResource StatusHint}"
                                               Margin="0,7,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Sheet parameter filter (Sheets mode only) -->
                            <Expander Name="expFilters"
                                      Header="Sheet parameter filter"
                                      IsExpanded="True"
                                      Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PARAMETER" Margin="0,6,0,4" />
                                    <ComboBox Name="cmbFilterParameter" IsEditable="False" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CONDITION" />
                                    <ComboBox Name="cmbFilterOperator" />

                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="VALUES  (Ctrl / Shift to pick several)" />
                                    <TextBox Name="txtFilterValueSearch"
                                             ToolTip="Type to narrow the value list below" />
                                    <ListBox Name="lstFilterValues"
                                             Height="112"
                                             Margin="0,5,0,0"
                                             SelectionMode="Extended" />

                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="TEXT  (contains / starts with / ends with)" />
                                    <TextBox Name="txtFilterText" />

                                    <Button Name="btnAddFilter"
                                            Style="{StaticResource PrimaryButton}"
                                            Tag="&#xE710;"
                                            Content="Add filter"
                                            Margin="0,12,0,0" />

                                    <TextBlock Style="{StaticResource FieldLabel}"
                                               Text="ACTIVE FILTERS  (a sheet must match all ticked)"
                                               Margin="0,14,0,4" />
                                    <DataGrid Name="dgFilters"
                                              Height="120"
                                              RowHeight="42"
                                              HeadersVisibility="None"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              IsReadOnly="False">
                                        <DataGrid.Columns>
                                            <!-- Template column: one click toggles the rule
                                                 (sheet_filter_ui listens for the bubbling Click). -->
                                            <DataGridTemplateColumn Header="On" Width="38">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  ToolTip="Switch this filter on or off" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Filter" Width="*" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding ValuesText, Mode=OneWay}">
                                                            <TextBlock Text="{Binding Parameter, Mode=OneWay}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Foreground="{StaticResource MutedBrush}"
                                                                       FontSize="11.5"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Operator, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ValuesText, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <UniformGrid Rows="1" Margin="0,8,0,0">
                                        <Button Name="btnRemoveFilter"
                                                Tag="&#xE738;"
                                                Content="Remove"
                                                Margin="0,0,4,0"
                                                ToolTip="Remove the highlighted filter" />
                                        <Button Name="btnClearFilters"
                                                Tag="&#xE74D;"
                                                Content="Clear all"
                                                Margin="4,0,0,0" />
                                    </UniformGrid>

                                    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                                        <TextBlock Name="txtFilterSummary"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource AccentPressedBrush}"
                                                   Text="No filter applied." />
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- View filter (Views mode only) -->
                            <GroupBox Name="grpViewFilters"
                                      Header="View filter"
                                      Visibility="Collapsed"
                                      Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="VIEW TYPE" Margin="0,2,0,4" />
                                    <ComboBox Name="cmbViewType" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="LEVEL" />
                                    <ComboBox Name="cmbViewLevel" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SHEET PLACEMENT" />
                                    <ComboBox Name="cmbViewSheetState" />
                                    <Button Name="btnViewResetFilters"
                                            Tag="&#xE72C;"
                                            Content="Reset filters and search"
                                            Margin="0,12,0,0" />
                                    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                                        <TextBlock Name="txtViewFilterSummary"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource AccentPressedBrush}" />
                                    </Border>
                                </StackPanel>
                            </GroupBox>

                            <!-- Saved selection sets -->
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Selection sets" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,3,0,8"
                                               Text="Save the ticked rows under a name and tick them again later." />
                                    <ComboBox Name="cmbSelectionSets" />
                                    <UniformGrid Rows="1" Margin="0,8,0,0">
                                        <Button Name="btnLoadSelectionSet"
                                                Tag="&#xE8E5;"
                                                Content="Load"
                                                Margin="0,0,4,0" />
                                        <Button Name="btnSaveSelectionSet"
                                                Tag="&#xE74E;"
                                                Content="Save as"
                                                Margin="2,0,2,0" />
                                        <Button Name="btnDeleteSelectionSet"
                                                Tag="&#xE74D;"
                                                Content="Delete"
                                                Margin="4,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ............ Right: search, range and the list itself ............ -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Toolbar (as ProSheets): View/Sheet Set on the left, export formats on the right -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource SubtleBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="8,8,0,0"
                                    Padding="14,9">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Formats"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0" />
                                        <CheckBox Name="chkPDF"
                                                  Style="{StaticResource FormatToggle}"
                                                  Tag="&#xEA90;"
                                                  Content="PDF"
                                                  IsChecked="True"
                                                  ToolTip="PDF - settings on step 2 (Format)" />
                                        <CheckBox Name="chkDWG"
                                                  Style="{StaticResource FormatToggle}"
                                                  Tag="&#xE81E;"
                                                  Content="DWG"
                                                  ToolTip="DWG - one AutoCAD file per sheet / view; export setup on step 2 (Format)" />
                                    </StackPanel>
                                    <TextBlock Text="View / Sheet Set"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox Name="cmbSheetSet"
                                              Width="260"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ToolTip="Show only the sheets / views of a saved Revit View/Sheet Set (Print > Print Setup). &lt;All&gt; shows everything." />
                                </DockPanel>
                            </Border>

                            <!-- Search -->
                            <DockPanel Grid.Row="1" Margin="14,12,14,0">
                                <TextBlock Name="txtSearchResult"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <Border Style="{StaticResource InputShell}">
                                    <Border.ToolTip>
                                        <TextBlock>
                                            Type to search. Every word must match (AND).<LineBreak />
                                            "exact phrase"   -exclude   field:value<LineBreak />
                                            Views fields : type  name  level  sheet  template  file<LineBreak />
                                            Sheets fields: number  name  file  filter<LineBreak />
                                            e.g.  type:section -dependent     level:"Level 01" sheet:A1     template:none<LineBreak />
                                            Enter = search now, Esc = clear.
                                        </TextBlock>
                                    </Border.ToolTip>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Style="{StaticResource Glyph}"
                                                   Text="&#xE721;"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="10,0,8,0" />
                                        <Button Name="btnClearSearch"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource IconButton}"
                                                Tag="&#xE711;"
                                                Margin="0,0,2,0"
                                                ToolTip="Clear search (Esc)" />
                                        <Grid>
                                            <TextBox Name="txtSearch" Style="{StaticResource BareTextBox}" />
                                            <TextBlock Text="Search...   words, &quot;exact phrase&quot;, -exclude, field:value"
                                                       Foreground="#FF98A4B0"
                                                       Margin="3,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </DockPanel>

                            <!-- Export range -->
                            <DockPanel Grid.Row="2" Margin="14,10,14,12">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Export"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Border DockPanel.Dock="Left"
                                        Style="{StaticResource SegmentTrack}"
                                        ToolTip="'Current window' and 'Visible portion' ignore the ticked rows and export only the view or sheet that is open and active in Revit - the full view for 'Current window', or cropped to exactly what is on screen for 'Visible portion'. Both need that view to still be open in a Revit window.">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Name="rbRangeSelected"
                                                     Style="{StaticResource Segment}"
                                                     Content="Ticked rows"
                                                     GroupName="ExportRange"
                                                     IsChecked="True" />
                                        <RadioButton Name="rbRangeCurrentWindow"
                                                     Style="{StaticResource Segment}"
                                                     Content="Current window"
                                                     GroupName="ExportRange" />
                                        <RadioButton Name="rbRangeVisiblePortion"
                                                     Style="{StaticResource Segment}"
                                                     Content="Visible portion"
                                                     GroupName="ExportRange" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Name="txtRangePreview"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Exports the checked rows below." />
                            </DockPanel>

                            <!-- The list -->
                            <DataGrid Name="dgItems"
                                      Grid.Row="3"
                                      BorderThickness="0,1,0,1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Extended"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      IsReadOnly="False">
                                <DataGrid.Columns>
                                    <!-- Template column: one click toggles the tick
                                         (DataGridCheckBoxColumn needed two clicks and
                                         the Selected count lagged behind). -->
                                    <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Number / Type"
                                                        Binding="{Binding Number}"
                                                        IsReadOnly="True"
                                                        Width="150" />
                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name}"
                                                        IsReadOnly="True"
                                                        Width="2*"
                                                        MinWidth="170" />
                                    <DataGridTextColumn Header="Revision"
                                                        Binding="{Binding Revision}"
                                                        IsReadOnly="True"
                                                        Width="90"
                                                        MinWidth="80" />
                                    <DataGridTextColumn Header="Size"
                                                        Binding="{Binding Size}"
                                                        IsReadOnly="True"
                                                        Width="72"
                                                        MinWidth="60" />
                                    <DataGridTextColumn Header="Level"
                                                        Binding="{Binding LevelName}"
                                                        IsReadOnly="True"
                                                        Width="105" />
                                    <DataGridTextColumn Header="On Sheet"
                                                        Binding="{Binding SheetRef}"
                                                        IsReadOnly="True"
                                                        Width="170" />
                                    <DataGridTextColumn Header="Custom File Name"
                                                        Binding="{Binding FileName}"
                                                        IsReadOnly="True"
                                                        Width="1.6*"
                                                        MinWidth="150" />
                                    <!-- Values of the parameters currently being
                                         filtered on; blank when no filter is set. -->
                                    <DataGridTextColumn Header="Filter Values"
                                                        Binding="{Binding FilterValues}"
                                                        IsReadOnly="True"
                                                        Width="190" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Shown over the list while it has no rows -->
                            <StackPanel Grid.Row="3"
                                        Style="{StaticResource EmptyState}"
                                        Margin="0,36,0,0"
                                        Tag="{Binding ElementName=dgItems}">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE71C;"
                                           FontSize="30"
                                           Foreground="{StaticResource LineStrongBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing to show"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,3" />
                                <TextBlock Style="{StaticResource Hint}"
                                           TextAlignment="Center"
                                           MaxWidth="360"
                                           Text="No sheets or views match the search / filter. Clear the search, or click Refresh from model." />
                            </StackPanel>

                            <!-- Tick tools -->
                            <DockPanel Grid.Row="4" Margin="14,9,14,10">
                                <Border DockPanel.Dock="Right"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="12"
                                        Padding="12,4"
                                        VerticalAlignment="Center">
                                    <TextBlock Name="txtCount"
                                               Text="Selected : 0"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentPressedBrush}" />
                                </Border>
                                <CheckBox Name="chkSelectAll"
                                          Content="Tick all shown"
                                          VerticalAlignment="Center"
                                          ToolTip="Ticks / unticks only the rows currently shown in the list" />
                                <Button Name="btnFilterDeselectAll"
                                        Tag="&#xE894;"
                                        Content="Clear all ticks"
                                        Margin="16,0,0,0"
                                        ToolTip="Untick every row, including rows hidden by the search / filter" />
                                <TextBlock Style="{StaticResource Hint}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,10,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Tip: highlight rows with Shift / Ctrl, then press Space to tick them." />
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============================================================
                 2. Format
                 ============================================================ -->
            <TabItem Header="Format" Tag="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="16,14,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: which formats + DWG -->
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <Border Style="{StaticResource InfoBox}">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentPressedBrush}"
                                           Text="Formats are switched on and off with the PDF / DWG buttons above the list on step 1 (Selection). Settings of a format that is off are greyed out here." />
                            </Border>

                            <GroupBox Header="DWG export setup"
                                      Margin="0,10,0,0"
                                      IsEnabled="{Binding IsChecked, ElementName=chkDWG}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SAVED REVIT DWG SETUP" Margin="0,2,0,4" />
                                    <ComboBox Name="cmbDWGSetup" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,6,0,0"
                                               Text="The setup controls layers, links / Xrefs, colours and units." />
                                    <Separator Margin="0,12" Background="{StaticResource LineBrush}" />
                                    <CheckBox Name="chkBindOLE" Content="Bind images as OLE in the DWG" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Margin="0,6,0,0"
                                               Text="Needs full AutoCAD (not LT) installed and licensed on this machine. After each DWG is written, AutoCAD is driven in the background to turn referenced images into embedded OLE objects and re-save. Adds time per file; any per-file issue is listed after the export." />
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 2: PDF output -->
                        <GroupBox Grid.Column="1"
                                  Header="PDF output"
                                  Margin="6,0,6,0"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding IsChecked, ElementName=chkPDF}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="PDF ENGINE" Margin="0,2,0,6" />
                                <RadioButton Name="rbEngineRevit"
                                             Content="Revit PDF export"
                                             GroupName="PdfEngine"
                                             IsChecked="True"
                                             ToolTip="Revit writes the PDF itself. Fast, and it can combine everything into one PDF." />
                                <RadioButton Name="rbEnginePrinter"
                                             Content="Print through a PDF printer (as ProSheets does)"
                                             GroupName="PdfEngine"
                                             Margin="0,8,0,0"
                                             ToolTip="Each sheet is PRINTED with Revit's print engine to the printer chosen below, so line weights come out as that printer makes them. With PDF24 the files are saved without any dialog; PDF24's own settings are put back afterwards. One PDF per sheet / view." />
                                <ComboBox Name="cmbPrinter" Margin="22,6,0,0"
                                          IsEnabled="{Binding IsChecked, ElementName=rbEnginePrinter}"
                                          ToolTip="PDF24 is driven fully automatically. Microsoft Print to PDF also works. A printer that asks for the file name itself cannot be automated." />
                                <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0" TextWrapping="Wrap"
                                           Text="The paper size is taken from each sheet's title block. Export quality (DPI) applies to Revit PDF export only." />

                                <Separator Margin="0,14,0,4" Background="{StaticResource LineBrush}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="FILES" Margin="0,10,0,6" />
                                <RadioButton Name="chkSeparate"
                                             Content="One PDF per sheet / view"
                                             GroupName="PdfMode"
                                             IsChecked="True" />
                                <RadioButton Name="chkCombined"
                                             Content="Combine everything into one PDF"
                                             GroupName="PdfMode"
                                             Margin="0,8,0,0" />

                                <Separator Margin="0,14,0,4" Background="{StaticResource LineBrush}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="PLACEMENT ON PAPER" Margin="0,10,0,6" />
                                <RadioButton Name="rbCenter"
                                             Content="Centre"
                                             GroupName="Placement"
                                             IsChecked="True" />
                                <RadioButton Name="rbOffset"
                                             Content="Offset from corner (lower left)"
                                             GroupName="Placement"
                                             Margin="0,8,0,0" />

                                <Separator Margin="0,14,0,4" Background="{StaticResource LineBrush}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="ZOOM" Margin="0,10,0,6" />
                                <RadioButton Name="rbFitPage"
                                             Content="Fit to page"
                                             GroupName="ZoomMode" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton Name="rbZoom"
                                                 Content="Zoom"
                                                 GroupName="ZoomMode"
                                                 IsChecked="True"
                                                 VerticalAlignment="Center" />
                                    <TextBox Name="txtZoom"
                                             Text="100"
                                             Width="58"
                                             Margin="12,0,6,0"
                                             HorizontalContentAlignment="Right"
                                             IsEnabled="{Binding IsChecked, ElementName=rbZoom}" />
                                    <TextBlock Text="%" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="Line weights are true to the Revit pen table only at Zoom 100 %. Fit to page and any other zoom scale the line widths with the drawing." />
                            </StackPanel>
                        </GroupBox>

                        <!-- Column 3: PDF appearance -->
                        <GroupBox Grid.Column="2"
                                  Header="PDF appearance"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Top"
                                  IsEnabled="{Binding IsChecked, ElementName=chkPDF}">
                            <StackPanel>
                                <Button Name="btnProSheets" Content="Use my ProSheets settings" HorizontalAlignment="Left" Padding="12,5"
                                        ToolTip="Sets every PDF option on this tab to the profile that is current in DiRoots ProSheets on this computer: placement, zoom, vector / raster, raster quality, colours, the hide options, halftone, coincident lines, and separate / combined files." />
                                <TextBlock Name="txtProSheets" Style="{StaticResource Hint}" Margin="0,6,0,10" TextWrapping="Wrap"
                                           Text="No ProSheets profile has been applied." />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RASTER QUALITY" Margin="0,2,0,4" />
                                <ComboBox Name="cmbRasterQuality" SelectedIndex="2">
                                    <ComboBoxItem Content="Low" />
                                    <ComboBoxItem Content="Medium" />
                                    <ComboBoxItem Content="High" />
                                    <ComboBoxItem Content="Presentation" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="EXPORT QUALITY (DPI)" />
                                <ComboBox Name="cmbExportQuality" SelectedIndex="0"
                                          ToolTip="The resolution the PDF is written at. Revit default leaves it to Revit, as ProSheets does. Line widths are rounded to the resolution: too low and the thin pens all come out the same width. Higher values give truer line weights and larger files.">
                                    <ComboBoxItem Content="Revit default" />
                                    <ComboBoxItem Content="300" />
                                    <ComboBoxItem Content="600" />
                                    <ComboBoxItem Content="1200" />
                                    <ComboBoxItem Content="2400" />
                                    <ComboBoxItem Content="4000" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="LINES" Margin="0,14,0,6" />
                                <CheckBox Name="chkHalftoneThin" Content="Replace halftone with thin lines"
                                          ToolTip="Halftone elements (underlays, linked models shown halftone) are drawn as thin solid lines instead of grey screened lines." />
                                <CheckBox Name="chkMaskCoincident" Content="Mask coincident lines" Margin="0,8,0,0"
                                          ToolTip="Where lines lie exactly on top of each other only the front one is drawn, so stacked lines do not print heavier than they should." />
                                <CheckBox Name="chkViewLinksBlue" Content="View links in blue (colour only)" Margin="0,8,0,0"
                                          ToolTip="Section, elevation and callout tags that link to another view are printed blue. Only has an effect in colour mode." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="COLOUR MODE" />
                                <ComboBox Name="cmbColorMode" SelectedIndex="0">
                                    <ComboBoxItem Content="Color" />
                                    <ComboBoxItem Content="Black Lines" />
                                    <ComboBoxItem Content="GrayScale" />
                                </ComboBox>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="HIDE IN OUTPUT" Margin="0,14,0,6" />
                                <CheckBox Name="chkHideCrop" Content="Crop boundaries" IsChecked="True" />
                                <CheckBox Name="chkHideScope" Content="Scope boxes" IsChecked="True" Margin="0,8,0,0" />
                                <CheckBox Name="chkHideRefs" Content="Reference / work planes" IsChecked="True" Margin="0,8,0,0" />
                                <CheckBox Name="chkHideUnrefTags" Content="Unreferenced view tags" IsChecked="True" Margin="0,8,0,0"
                                          ToolTip="Section, elevation and callout tags whose view is not on a sheet are left out." />

                                <Separator Margin="0,14,0,4" Background="{StaticResource LineBrush}" />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="OUTPUT PROCESSING" Margin="0,10,0,6" />
                                <RadioButton Name="rbVectorProcessing"
                                             Content="Vector processing"
                                             GroupName="OutputProcessing"
                                             IsChecked="True" />
                                <RadioButton Name="rbRasterProcessing"
                                             Content="Raster processing"
                                             GroupName="OutputProcessing"
                                             Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="0,8,0,0"
                                           Text="Vector gives smaller, sharper PDFs. Raster can fix views that print blank or incomplete." />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================
                 3. Create  (as ProSheets: output folder, naming rule, the files to make)
                 ============================================================ -->
            <TabItem Header="Create" Tag="3">
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="160" />
                    </Grid.RowDefinitions>

                    <!-- Output folder + one-line summary -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Style="{StaticResource CardTitle}"
                                           Text="Output folder"
                                           VerticalAlignment="Center"
                                           Width="120" />
                                <Button Name="btnOpenFolder"
                                        DockPanel.Dock="Right"
                                        Tag="&#xE838;"
                                        Content="Open"
                                        Width="90"
                                        Margin="8,0,0,0"
                                        ToolTip="Open the output folder in Explorer" />
                                <Button Name="btnBrowse"
                                        DockPanel.Dock="Right"
                                        Tag="&#xED25;"
                                        Content="Browse"
                                        Width="100"
                                        Margin="8,0,0,0" />
                                <TextBox Name="txtFolder"
                                         ToolTip="Created if it does not exist. Files with the same name from an earlier export are overwritten." />
                            </DockPanel>
                            <Grid Margin="120,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabel}" Text="WHAT" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Name="txtSumItems" Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0" />
                                <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" Text="FORMATS" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Name="txtSumFormats" Grid.Column="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <!-- kept for ui.py (filled, not shown separately) -->
                            <TextBlock Name="txtSumNames" Visibility="Collapsed" />
                            <TextBlock Name="txtSumFolder" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- File naming rule: collapsible; the preview line stays visible -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Name="btnRefreshFormat" Tag="&#xE72C;" Content="Refresh" />
                                    <Button Name="btnLoadFormat" Tag="&#xE8E5;" Content="Load rule" Margin="8,0,0,0" />
                                    <Button Name="btnSaveFormat" Tag="&#xE74E;" Content="Save rule" Margin="8,0,0,0" />
                                    <ToggleButton Name="tglEditNaming"
                                                  Style="{StaticResource ToggleAction}"
                                                  Tag="&#xE70F;"
                                                  Content="Edit naming rule"
                                                  Margin="8,0,0,0"
                                                  ToolTip="Show / hide the parameter list and separators" />
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Style="{StaticResource CardTitle}"
                                           Text="File name"
                                           VerticalAlignment="Center"
                                           Width="120" />
                                <Border Background="{StaticResource SubtleBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,0"
                                        Height="34"
                                        Margin="0,0,14,0">
                                    <TextBlock Name="txtFormatPreview"
                                               FontFamily="Consolas"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="Example: the name of the first ticked sheet / view" />
                                </Border>
                            </DockPanel>

                            <!-- Fixed text before / after every file name -->
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Left"
                                           Style="{StaticResource CardTitle}"
                                           Text="Add text"
                                           VerticalAlignment="Center"
                                           Width="120" />
                                <Border DockPanel.Dock="Left" Style="{StaticResource InputShell}" Width="200">
                                    <Grid Margin="10,0">
                                        <TextBlock Style="{StaticResource Watermark}"
                                                   Tag="{Binding ElementName=txtFilePrefix}"
                                                   Text="Prefix, e.g. QTC_" />
                                        <TextBox Name="txtFilePrefix"
                                                 Style="{StaticResource BareTextBox}"
                                                 ToolTip="Text added in FRONT of every file name, e.g. QTC_  (include your own separator)" />
                                    </Grid>
                                </Border>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="+ name +"
                                           FontFamily="Consolas"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           ToolTip="The file name from the rule above goes between prefix and suffix" />
                                <Border DockPanel.Dock="Left" Style="{StaticResource InputShell}" Width="200">
                                    <Grid Margin="10,0">
                                        <TextBlock Style="{StaticResource Watermark}"
                                                   Tag="{Binding ElementName=txtFileSuffix}"
                                                   Text="Suffix, e.g. _For Review" />
                                        <TextBox Name="txtFileSuffix"
                                                 Style="{StaticResource BareTextBox}"
                                                 ToolTip="Text added at the END of every file name, before .pdf / .dwg, e.g. _For Review" />
                                    </Grid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="Optional. Include your own separator. Saved with the naming rule." />
                            </DockPanel>

                            <Grid Name="grdNaming"
                                  Height="300"
                                  Margin="0,12,0,0"
                                  Visibility="{Binding IsChecked, ElementName=tglEditNaming, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Available parameters" Grid.Column="0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" Style="{StaticResource InputShell}" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Style="{StaticResource Glyph}"
                                                           Text="&#xE721;"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="10,0,8,0" />
                                                <TextBox Name="txtParamSearch"
                                                         Style="{StaticResource BareTextBox}"
                                                         Margin="0,0,8,0"
                                                         ToolTip="Type to narrow the parameter list" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Bottom"
                                                   Style="{StaticResource Hint}"
                                                   Margin="0,6,0,0"
                                                   Text="Double-click to add. 'Project: ...' = Project Information." />
                                        <ListBox Name="lstAvailableParams" />
                                    </DockPanel>
                                </GroupBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Width="124">
                                    <Button Name="btnAddParam" Style="{StaticResource PrimaryButton}" Tag="&#xE72A;" Content="Add" Height="32" />
                                    <Button Name="btnRemoveParam" Tag="&#xE72B;" Content="Remove" Height="32" Margin="0,8,0,0" />
                                    <Button Name="btnMoveUp" Tag="&#xE74A;" Content="Move up" Height="32" Margin="0,22,0,0" />
                                    <Button Name="btnMoveDown" Tag="&#xE74B;" Content="Move down" Height="32" Margin="0,8,0,0" />
                                </StackPanel>

                                <GroupBox Header="File name sequence" Grid.Column="2" Margin="0,0,6,0">
                                    <ListBox Name="lstSelectedParams" />
                                </GroupBox>
                                <GroupBox Header="Separators" Grid.Column="3" Margin="6,0,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom"
                                                   Style="{StaticResource Hint}"
                                                   Margin="0,6,0,0"
                                                   Text="Double-click to edit:  -  _  .  +  space or blank." />
                                        <DataGrid Name="dgSeparators"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  CanUserSortColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn Header="Separator after it" Binding="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </GroupBox>
                            </Grid>
                            <!-- Kept off-screen: filename_builder.py writes the same preview text here too. -->
                            <TextBox Name="txtPreview" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- The files that will be created, with live status -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                        <Grid ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="14,10,14,8">
                                <TextBlock Name="txtProgressSummary"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="Files to create" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid Name="dgProgress"
                                      Grid.Row="1"
                                      BorderThickness="0,1,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      EnableRowVirtualization="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="running">
                                                <Setter Property="Background" Value="#FFE8F1FC" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="done">
                                                <Setter Property="Background" Value="#FFEAF6EC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="failed">
                                                <Setter Property="Background" Value="#FFFDECEC" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="skipped">
                                                <Setter Property="Background" Value="#FFFFF4DC" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44" />
                                    <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="70" />
                                    <DataGridTextColumn Header="Sheet / View" Binding="{Binding Label}" Width="1.2*" MinWidth="140" />
                                    <DataGridTextColumn Header="File name" Binding="{Binding FileName}" Width="1.6*" MinWidth="160" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="1.4*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Shown while no files are listed yet -->
                            <StackPanel Grid.Row="1"
                                        Style="{StaticResource EmptyState}"
                                        Margin="0,36,0,0"
                                        Tag="{Binding ElementName=dgProgress}">
                                <TextBlock Style="{StaticResource Glyph}"
                                           Text="&#xE8A5;"
                                           FontSize="30"
                                           Foreground="{StaticResource LineStrongBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="No files yet"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,3" />
                                <TextBlock Style="{StaticResource Hint}"
                                           TextAlignment="Center"
                                           MaxWidth="380"
                                           Text="Tick sheets or views on step 1 and switch on PDF and / or DWG. The files to create are listed here with their live status." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>        </TabControl>

        <!-- ================================================================
             Footer: status + wizard navigation + EXPORT (always reachable)
             ================================================================ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="btnBack"
                            Tag="&#xE72B;"
                            Content="Back"
                            Width="96"
                            Height="38" />
                    <Button Name="btnNext"
                            Width="96"
                            Height="38"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Glyph}"
                                       Text="&#xE72A;"
                                       FontSize="13"
                                       Margin="7,1,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Name="btnExport"
                            Style="{StaticResource GoButton}"
                            Tag="&#xE72D;"
                            Content="CREATE"
                            MinWidth="170"
                            Margin="18,0,0,0" />
                </StackPanel>
                <TextBlock Name="txtFooterStatus"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
