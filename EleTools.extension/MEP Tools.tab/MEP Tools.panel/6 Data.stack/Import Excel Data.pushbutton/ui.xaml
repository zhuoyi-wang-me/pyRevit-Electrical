<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel to Revit MEP" Height="940" Width="1260" MinHeight="640" MinWidth="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#EEF4FF"
        FontFamily="Segoe UI" FontSize="12">

  <!-- ===================================================================
       Bright theme. Every step has its own colour (set as BorderBrush on
       its GroupBox); buttons are colour-coded by what they do:
         blue   = ordinary action        green  = writes into Revit / go
         orange = export to Excel        red    = delete
       =================================================================== -->
  <Window.Resources>
    <!-- step colours -->
    <SolidColorBrush x:Key="Blue" Color="#1E88E5"/>
    <SolidColorBrush x:Key="Violet" Color="#8E24AA"/>
    <SolidColorBrush x:Key="Orange" Color="#FB8C00"/>
    <SolidColorBrush x:Key="Teal" Color="#00ACC1"/>
    <SolidColorBrush x:Key="Green" Color="#00B85C"/>
    <SolidColorBrush x:Key="Pink" Color="#EC407A"/>
    <SolidColorBrush x:Key="Indigo" Color="#3D5AFE"/>
    <SolidColorBrush x:Key="Red" Color="#E53935"/>

    <!-- Coloured header band + rounded white body -->
    <Style TargetType="GroupBox">
      <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                    CornerRadius="8" SnapsToDevicePixels="True">
              <DockPanel>
                <Border DockPanel.Dock="Top" Background="{TemplateBinding BorderBrush}" CornerRadius="6,6,0,0" Padding="10,6">
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="False"
                                    TextElement.Foreground="White" TextElement.FontWeight="SemiBold" TextElement.FontSize="13"/>
                </Border>
                <ContentPresenter/>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons: rounded, outlined blue by default -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1565C0"/>
      <Setter Property="BorderBrush" Value="#64B5F6"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#0D47A1"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BlueBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Blue}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Blue}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Orange}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Orange}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource Red}"/>
      <Setter Property="BorderBrush" Value="#EF9A9A"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="BorderBrush" Value="#BBDEFB"/>
      <Setter Property="Background" Value="#FAFCFF"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="BorderBrush" Value="#90CAF9"/>
      <Setter Property="Padding" Value="3,0"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#1A237E"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="18,14" CornerRadius="10" Margin="0,0,0,12">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#1E88E5" Offset="0"/>
          <GradientStop Color="#7C4DFF" Offset="0.55"/>
          <GradientStop Color="#EC407A" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="23" Background="#33FFFFFF" Margin="0,0,14,0"
                VerticalAlignment="Center">
          <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Excel ⇄ Revit MEP" Foreground="White" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="Export any MEP discipline to a workbook, edit it, and write it back. Element Id round-trips exactly."
                     Foreground="#F3F0FF" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Background="White" BorderBrush="#B39DDB" BorderThickness="1.5" Padding="12,10" CornerRadius="8" Margin="0,0,0,10">
     <StackPanel>
      <!-- Saved setups: everything chosen in this window, kept for next time -->
      <DockPanel Margin="0,0,0,8">
        <TextBlock Text="TEMPLATE" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="11" Foreground="#7C4DFF" Width="64"/>
        <ComboBox x:Name="templates" Width="300" VerticalAlignment="Center"
                  ToolTip="A template remembers the source, ticked categories / schedules / families, the parameter filter, export parameters, workbook, worksheet, matching and import columns."/>
        <Button x:Name="template_load" Content="Load" Width="70" Height="26" Style="{StaticResource BlueBtn}" Margin="8,0,0,0"/>
        <Button x:Name="template_save" Content="Save current setup..." Width="160" Height="26" Style="{StaticResource GreenBtn}" Margin="8,0,0,0"/>
        <Button x:Name="template_delete" Content="Delete" Width="70" Height="26" Style="{StaticResource RedBtn}" Margin="8,0,0,0"/>
        <TextBlock x:Name="template_note" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#5C6B8A" FontSize="11"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="SOURCE" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="11" Foreground="#1E88E5" Width="64"/>
        <RadioButton x:Name="category_mode" GroupName="SourceMode" Content="By Category / Family" IsChecked="True" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <RadioButton x:Name="schedule_mode" GroupName="SourceMode" Content="By Revit Schedule" VerticalAlignment="Center" Margin="0,0,28,0"/>
        <CheckBox x:Name="allow_type_params" Content="Include type parameters" VerticalAlignment="Center" Margin="0,0,18,0"
                  ToolTip="Type parameters are shared by every instance of that type. Writing one changes them all."/>
        <CheckBox x:Name="export_units" Content="Keep unit suffixes on export" VerticalAlignment="Center" Margin="0,0,18,0"
                  ToolTip="Off by default: Excel misreads values like '5 A' as a time."/>
        <CheckBox x:Name="split_by_category" Content="One sheet per category" VerticalAlignment="Center"/>
      </StackPanel>
     </StackPanel>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="170"/>
        <ColumnDefinition Width="150"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="file_path" Grid.Column="0" Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Background="White" BorderBrush="#00B85C" BorderThickness="1.5" Padding="6,0"/>
      <Button x:Name="browse" Grid.Column="1" Content="Browse Excel File" Margin="8,0,8,0" Height="30" Style="{StaticResource GreenBtn}"/>
      <Button x:Name="load_sheet" Grid.Column="2" Content="Load Sheet" Height="30" Style="{StaticResource BlueBtn}"/>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

          <StackPanel x:Name="category_panel">
            <GroupBox Header="1. Element Categories" Height="230" BorderBrush="{StaticResource Blue}" Margin="0,0,0,8">
              <DockPanel Margin="6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5C6B8A" FontSize="11"/>
                  <TextBox x:Name="categories_search" Height="22" VerticalContentAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                  <Button x:Name="categories_all" Content="All" Width="48" Height="20" FontSize="10" Margin="0,0,4,0"/>
                  <Button x:Name="categories_none" Content="None" Width="48" Height="20" FontSize="10"/>
                </StackPanel>
                <ListBox x:Name="categories" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </GroupBox>
          </StackPanel>

          <StackPanel x:Name="schedule_panel" Visibility="Collapsed">
            <GroupBox Header="1. Revit Schedules (tick one or more)" Height="490" BorderBrush="{StaticResource Blue}" Margin="0,0,0,8">
              <DockPanel Margin="6">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5C6B8A" FontSize="11"/>
                  <TextBox x:Name="schedules_search" Height="22" VerticalContentAlignment="Center"/>
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                  <Button x:Name="schedules_all" Content="All" Width="48" Height="20" FontSize="10" Margin="0,0,4,0"/>
                  <Button x:Name="schedules_none" Content="None" Width="48" Height="20" FontSize="10"/>
                  <TextBlock x:Name="schedules_count" VerticalAlignment="Center" HorizontalAlignment="Right"
                             Foreground="#1565C0" FontWeight="SemiBold" FontSize="11"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <TextBlock Text="Workbook layout" Foreground="#5C6B8A" FontSize="11"/>
                  <ComboBox x:Name="schedule_layout" Margin="0,3,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="One workbook - one sheet per schedule"/>
                    <ComboBoxItem Content="One workbook - all schedules on one sheet"/>
                    <ComboBoxItem Content="Separate workbook for each schedule"/>
                  </ComboBox>
                  <TextBlock Text="Content" Foreground="#5C6B8A" FontSize="11"/>
                  <ComboBox x:Name="schedule_content" Margin="0,3,0,8" SelectedIndex="0"
                            ToolTip="Editable data can be imported back. 'As shown in Revit' is a copy of the schedule for reports and cannot be imported.">
                    <ComboBoxItem Content="Editable data with Element Id (import back)"/>
                    <ComboBoxItem Content="As shown in Revit (report copy only)"/>
                  </ComboBox>
                  <Button x:Name="export_schedule" Content="Export Ticked Schedules to Excel" Height="30" Style="{StaticResource OrangeBtn}"/>
                  <TextBlock x:Name="schedule_hint" Foreground="#5C6B8A" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="Sheets are named after the schedules (Excel allows 31 characters). To import back, browse to the workbook and pick the worksheet in step 5."/>
                </StackPanel>

                <ListBox x:Name="schedules" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
              </DockPanel>
            </GroupBox>
          </StackPanel>

          <GroupBox Header="2. Families" Height="210" BorderBrush="{StaticResource Violet}" Margin="0,0,0,8">
            <DockPanel Margin="6">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5C6B8A" FontSize="11"/>
                <TextBox x:Name="families_search" Height="22" VerticalContentAlignment="Center"/>
              </DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="families_all" Content="All" Width="48" Height="20" FontSize="10" Margin="0,0,4,0"/>
                <Button x:Name="families_none" Content="None" Width="48" Height="20" FontSize="10"/>
              </StackPanel>
              <ListBox x:Name="families" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </GroupBox>

          <GroupBox Header="3. Filter by Parameter Value" BorderBrush="{StaticResource Orange}" Margin="0,0,0,8">
            <StackPanel Margin="8">
              <TextBlock Text="Only elements that pass every rule are previewed, imported and exported."
                         Foreground="#5C6B8A" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <ComboBox x:Name="filter1_param" Margin="0,0,0,3" ToolTip="Parameter (or Category / Family / Type) to test"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="filter1_op" Grid.Column="0" Margin="0,0,4,0"/>
                <TextBox x:Name="filter1_value" Grid.Column="1" Height="22" VerticalContentAlignment="Center"/>
              </Grid>
              <TextBlock Text="and" Foreground="#5C6B8A" FontSize="11" Margin="0,0,0,3"/>
              <ComboBox x:Name="filter2_param" Margin="0,0,0,3"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="filter2_op" Grid.Column="0" Margin="0,0,4,0"/>
                <TextBox x:Name="filter2_value" Grid.Column="1" Height="22" VerticalContentAlignment="Center"/>
              </Grid>
              <DockPanel>
                <Button x:Name="filter_apply" Content="Apply filter" Width="90" Height="26" Margin="0,0,4,0" Style="{StaticResource OrangeBtn}"/>
                <Button x:Name="filter_clear" Content="Clear" Width="60" Height="26"/>
                <TextBlock x:Name="filter_note" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="#E65100" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="8,0,0,0"/>
              </DockPanel>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="4. Parameters to Export" Height="245" BorderBrush="{StaticResource Teal}" Margin="0,0,0,8">
            <DockPanel Margin="6">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5C6B8A" FontSize="11"/>
                <TextBox x:Name="export_params_search" Height="22" VerticalContentAlignment="Center"/>
              </DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="export_params_all" Content="All" Width="48" Height="20" FontSize="10" Margin="0,0,4,0"/>
                <Button x:Name="export_params_none" Content="None" Width="48" Height="20" FontSize="10"/>
              </StackPanel>
              <Button x:Name="export_elements" DockPanel.Dock="Bottom" Content="Export Elements to Excel" Height="30" Margin="0,6,0,0" Style="{StaticResource OrangeBtn}"/>
              <ListBox x:Name="export_params" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </GroupBox>

          <GroupBox Header="5. Excel Configuration" Height="235" BorderBrush="{StaticResource Green}" Margin="0,0,0,8">
            <StackPanel Margin="8">
              <TextBlock Text="Worksheet" Foreground="#5C6B8A" FontSize="11"/>
              <ComboBox x:Name="sheets" Margin="0,3,0,8"/>
              <TextBlock Text="Excel match column" Foreground="#5C6B8A" FontSize="11"/>
              <ComboBox x:Name="excel_key" Margin="0,3,0,6"/>
              <CheckBox x:Name="match_by_id" Content="Match using Element Id" Margin="0,0,0,6"/>
              <TextBlock x:Name="revit_key_label" Text="Revit matching parameter" Foreground="#5C6B8A" FontSize="11"/>
              <ComboBox x:Name="revit_key" Margin="0,3,0,0"/>
              <TextBlock x:Name="duplicate_note" Foreground="#E53935" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="6. Columns to Import" Height="210" BorderBrush="{StaticResource Pink}">
            <DockPanel Margin="6">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#5C6B8A" FontSize="11"/>
                <TextBox x:Name="excel_columns_search" Height="22" VerticalContentAlignment="Center"/>
              </DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="excel_columns_all" Content="All" Width="48" Height="20" FontSize="10" Margin="0,0,4,0"/>
                <Button x:Name="excel_columns_none" Content="None" Width="48" Height="20" FontSize="10"/>
              </StackPanel>
              <ListBox x:Name="excel_columns" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
          </GroupBox>

        </StackPanel>
      </ScrollViewer>

      <GroupBox Grid.Column="1" Header="7. Match Preview (matching elements first)" BorderBrush="{StaticResource Indigo}">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="preview" Content="Refresh Preview" Width="130" Height="30" Margin="0,0,10,0" Style="{StaticResource BlueBtn}"/>
            <TextBlock x:Name="summary" VerticalAlignment="Center" Foreground="#283593" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </StackPanel>
          <ListBox x:Name="match_list" FontFamily="Consolas" FontSize="12.5" Background="White" BorderBrush="#C5CAE9"/>
        </DockPanel>
      </GroupBox>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="export_results" Content="Export Import Results" Width="165" Height="34" Margin="0,0,8,0" IsEnabled="False" Style="{StaticResource OrangeBtn}"/>
      <Button x:Name="import_data" Content="Import Selected Data  ▶" Width="185" Height="34" Margin="0,0,8,0" FontSize="13" Style="{StaticResource GreenBtn}"/>
      <Button x:Name="cancel" Content="Cancel" Width="95" Height="34"/>
    </StackPanel>
  </Grid>
</Window>
