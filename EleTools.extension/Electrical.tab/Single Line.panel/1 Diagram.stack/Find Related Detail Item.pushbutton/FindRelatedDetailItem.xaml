<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Related Detail Item" Height="620" Width="1180" MinHeight="420" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- STEP 1: Detail Item parameter -->
    <GroupBox Grid.Row="0" Header="1. Detail Item parameter (set before searching)" Padding="6">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Parameter name:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="param_combo" Grid.Row="0" Grid.Column="1" Height="26" IsEditable="True" IsTextSearchEnabled="True"
                  SelectionChanged="on_param_selected" PreviewKeyDown="on_param_keydown"
                  ToolTip="Pick from parameters found on scanned elements, or type a name and press Enter / Apply." />
        <Button Grid.Row="0" Grid.Column="2" Width="70" Height="26" Margin="8,0,0,0" Content="Apply" Click="on_param_apply" />
        <Button Grid.Row="0" Grid.Column="3" Width="130" Height="26" Margin="8,0,0,0" Content="Pick Detail Item" Click="on_pick_detail"
                ToolTip="Select ONE detail item in Revit first. Shows all its parameters, its view and category." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Views:" VerticalAlignment="Center" Margin="0,8,8,0" />
        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
          <TextBlock Text="All views are searched (drafting views, floor plans, sections, legends...)." VerticalAlignment="Center" Foreground="#FF505050" />
          <CheckBox x:Name="detail_only_check" Margin="14,0,0,0" VerticalAlignment="Center"
                    Content="Detail Items category only" Checked="on_detail_only_changed" Unchecked="on_detail_only_changed" />
          <Button Width="110" Height="26" Margin="14,0,0,0" Content="Rebuild Index" Click="on_rebuild_clicked"
                  ToolTip="Re-scan (use after editing the model)." />
        </StackPanel>
        <TextBlock x:Name="param_info" Grid.Row="2" Grid.ColumnSpan="4" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF505050" />
      </Grid>
    </GroupBox>

    <!-- STEP 2: Source element -->
    <GroupBox Grid.Row="1" Header="2. Source element" Padding="6" Margin="0,8,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="selection_text" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6" TextWrapping="Wrap" Text="No element selected." />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Use parameter:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="source_combo" Grid.Row="1" Grid.Column="1" Height="26" DisplayMemberPath="Label" SelectionChanged="on_source_changed" />
        <Button Grid.Row="1" Grid.Column="2" Width="150" Height="26" Margin="8,0,0,0" Content="Get From Selection" Click="on_get_selection" />
      </Grid>
    </GroupBox>

    <!-- STEP 3: Search -->
    <GroupBox Grid.Row="2" Header="3. Search" Padding="6" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" />
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="value_box" Grid.Column="1" Height="26" VerticalContentAlignment="Center" KeyDown="on_value_keydown"
                 ToolTip="Value to look for. Edit freely, then press Enter or Search." />
        <TextBlock Grid.Column="2" Text="Match:" VerticalAlignment="Center" Margin="12,0,8,0" />
        <ComboBox x:Name="mode_combo" Grid.Column="3" Height="26" SelectedIndex="1" SelectionChanged="on_mode_changed">
          <ComboBoxItem Content="Exact" />
          <ComboBoxItem Content="Loose (ignore - _ . space)" />
          <ComboBoxItem Content="Contains" />
          <ComboBoxItem Content="Starts with" />
          <ComboBoxItem Content="Show ALL with a value" />
        </ComboBox>
        <TextBlock Grid.Column="4" Text="Search in:" VerticalAlignment="Center" Margin="12,0,8,0" />
        <ComboBox x:Name="search_in_combo" Grid.Column="5" Height="26" SelectedIndex="0" SelectionChanged="on_search_in_changed">
          <ComboBoxItem Content="Chosen parameter" />
          <ComboBoxItem Content="ANY text parameter" />
        </ComboBox>
        <Button Grid.Column="6" Width="80" Height="26" Margin="8,0,0,0" Content="Search" Click="on_search_clicked" />
      </Grid>
    </GroupBox>

    <!-- Result filter -->
    <Grid Grid.Row="3" Margin="0,10,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Filter results:" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="filter_box" Grid.Column="1" Height="26" VerticalContentAlignment="Center" TextChanged="on_filter_changed" />
    </Grid>

    <!-- Results -->
    <ListView x:Name="results_list" Grid.Row="4" MouseDoubleClick="on_result_double_click" SelectionMode="Single">
      <ListView.View>
        <GridView>
          <GridViewColumn Header="Value" Width="170" DisplayMemberBinding="{Binding Value}" />
          <GridViewColumn Header="View" Width="210" DisplayMemberBinding="{Binding ViewName}" />
          <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding CategoryName}" />
          <GridViewColumn Header="Family" Width="170" DisplayMemberBinding="{Binding FamilyName}" />
          <GridViewColumn Header="Type" Width="130" DisplayMemberBinding="{Binding TypeName}" />
          <GridViewColumn Header="Element Id" Width="85" DisplayMemberBinding="{Binding IdText}" />
          <GridViewColumn Header="Read From" Width="150" DisplayMemberBinding="{Binding Source}" />
        </GridView>
      </ListView.View>
    </ListView>

    <!-- Footer -->
    <Grid Grid.Row="5" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="status_text" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Width="145" Height="28" Margin="8,0,0,0" Content="Use This Parameter" Click="on_use_parameter"
              ToolTip="Set the selected row's parameter as the Detail Item parameter." />
      <Button Grid.Column="2" Width="135" Height="28" Margin="8,0,0,0" Content="Open and Select" Click="on_open_clicked" />
      <Button Grid.Column="3" Width="82" Height="28" Margin="8,0,0,0" Content="Close" Click="on_close_clicked" />
    </Grid>
  </Grid>
</Window>
