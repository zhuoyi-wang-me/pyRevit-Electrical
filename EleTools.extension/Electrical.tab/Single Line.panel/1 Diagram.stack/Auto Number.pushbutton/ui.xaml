<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Breaker Auto Numbering" Height="640" Width="780"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F4F4F4">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="4,4,4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Circuit Breaker Auto Numbering" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="txtSelectionInfo" Text="0 elements selected"
                   FontSize="12" Foreground="#777777" Margin="0,0,0,10"/>

        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1" Background="White"
                Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="TARGET PARAMETER"/>
                        <ComboBox x:Name="cmbParameter" IsEditable="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Label Content="PREFIX"/>
                        <TextBox x:Name="txtPrefix" Text="CB-"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="START NUMBER"/>
                        <TextBox x:Name="txtStart" Text="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <Label Content="INCREMENT"/>
                        <TextBox x:Name="txtIncrement" Text="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <Label Content="PADDING (DIGITS)"/>
                        <TextBox x:Name="txtPadding" Text="2"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="SORT ORDER"/>
                        <ComboBox x:Name="cmbSort" SelectedIndex="1">
                            <ComboBoxItem Content="Selection order (as picked)"/>
                            <ComboBoxItem Content="Left to right (X position)"/>
                            <ComboBoxItem Content="Right to left (X position)"/>
                            <ComboBoxItem Content="Top to bottom (Y position)"/>
                            <ComboBoxItem Content="Bottom to top (Y position)"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="btnReselect" Content="Reselect Elements"
                            Click="btnReselect_Click" VerticalAlignment="Bottom"/>
                    <Button Grid.Column="2" x:Name="btnRefresh" Content="Update Preview"
                            Click="btnRefresh_Click" VerticalAlignment="Bottom"
                            Background="#1565C0" Foreground="White"/>
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="3" x:Name="dgPreview" AutoGenerateColumns="False"
                   CanUserAddRows="False" IsReadOnly="True" Margin="0,0,0,10"
                   AlternatingRowBackground="#F7F7F7" GridLinesVisibility="Horizontal"
                   HeadersVisibility="Column" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="40"/>
                <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                <DataGridTextColumn Header="Family / Type" Binding="{Binding TypeName}" Width="*"/>
                <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}" Width="130"/>
                <DataGridTextColumn Header="New Value" Binding="{Binding NewValue}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" x:Name="txtStatus" Text="" Foreground="#B00020"
                   Margin="0,0,0,6" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="100" Click="btnCancel_Click"/>
            <Button x:Name="btnApply" Content="Apply Numbering" Width="150" Click="btnApply_Click"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
