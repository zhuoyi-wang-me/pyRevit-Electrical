<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SLD Checker" Width="1120" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F3F3F3" Foreground="#1B1B1B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ============ buttons ============ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F2F2F2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E9E9E9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Accent" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#005FB8" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A6FBF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#3380C6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ text field ============ -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="White" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Background="#8A8A8A" Margin="1,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="line" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="line" Property="Height" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>

        <!-- ============ check box ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A" Background="White" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="1.6" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============ cards / text ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ============ tabs: text with an accent underline ============ -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,0,22,0" Background="Transparent">
                            <ContentPresenter x:Name="h" ContentSource="Header" Margin="2,6,2,10" TextBlock.FontSize="14" TextBlock.Foreground="#5C5C5C"/>
                            <Border x:Name="u" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Background="#005FB8" Visibility="Hidden" Margin="2,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="u" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="h" Property="TextBlock.Foreground" Value="#1B1B1B"/>
                                <Setter TargetName="h" Property="TextBlock.FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="h" Property="TextBlock.Foreground" Value="#1B1B1B"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== header: title + template bar ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SLD Checker" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock x:Name="subtitle_text" Style="{StaticResource Caption}"
                           Text="Map the parameters, choose what to check, save it as a template. Read-only - the model is never changed."/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Template" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="template_combo" Width="210" SelectionChanged="on_template_selected"/>
                    <Button Content="Save" Click="on_save" ToolTip="Save the current settings into this template"/>
                    <Button Content="Save As..." Click="on_save_as"/>
                    <Button Content="Delete" Click="on_delete"/>
                    <Button Content="Import..." Click="on_import" ToolTip="Load a template JSON shared by a colleague"/>
                    <Button Content="Export..." Click="on_export" ToolTip="Save the current settings as a JSON file to share"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== body ===== -->
        <TabControl x:Name="tabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,10,0,0">

            <!-- 1. Scope & checks -->
            <TabItem Header="1  Scope &amp; Checks">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Which SLD views?" Style="{StaticResource CardTitle}"/>
                                <RadioButton x:Name="rb_all" GroupName="scope" Content="All views with Detail Items" Checked="on_scope_changed"/>
                                <RadioButton x:Name="rb_active" GroupName="scope" Content="Active view only" Checked="on_scope_changed"/>
                                <RadioButton x:Name="rb_pick" GroupName="scope" Content="Picked views" Checked="on_scope_changed"/>
                                <TextBlock x:Name="scope_hint" Style="{StaticResource Caption}" Margin="0,4,0,8"/>
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="view_filter" Style="{StaticResource Field}" TextChanged="on_view_filter" ToolTip="Filter views"/>
                                    <TextBlock Text="Filter views..." Foreground="#9A9A9A" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" x:Name="view_filter_hint"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="All" Click="on_views_all" Margin="0" Height="26" Padding="10,0"/>
                                    <Button Content="None" Click="on_views_none" Height="26" Padding="10,0"/>
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="views_panel"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <TextBlock Text="What to check" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="All on" Click="on_checks_all" Height="26" Padding="10,0"/>
                                    <Button Content="All off" Click="on_checks_none" Height="26" Padding="10,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Greyed checks are always on: duplicates and ambiguous names are never hidden, so nothing is matched silently."/>
                            <CheckBox DockPanel.Dock="Bottom" x:Name="chk_show_info" Margin="0,8,0,0"
                                      Content="Show INFO rows (formatting hints, values not comparable, drawn in several views)"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="checks_panel" Orientation="Vertical"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. SLD parameters -->
            <TabItem Header="2  SLD Parameters">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Detail Item parameters on the single line diagram" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock x:Name="sld_info" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Auto-detect" Click="on_auto_detect" ToolTip="Fill empty / not-found fields with the best matching parameter found on the Detail Items"/>
                                <Button Content="Reset to defaults" Click="on_reset_sld"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                   Text="Pick a parameter from the list or type it. Several names separated by commas are tried in order (for mixed families). 'bip:NAME' = Revit built-in parameter."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="sld_grid"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 3. Model parameters -->
            <TabItem Header="3  Model Parameters">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Model element parameters" Style="{StaticResource CardTitle}" Margin="0"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Defaults use Revit built-in electrical parameters. Change them only if your project keeps the values elsewhere (e.g. BCC_Cable, MEE-CableSize)."/>
                            </StackPanel>
                            <Button Content="Reset to defaults" Click="on_reset_model" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="model_panel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 4. Recognition & options -->
            <TabItem Header="4  Recognition &amp; Options">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="How SLD symbols are recognised" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                                           Text="Keywords found in 'Family : Type' of a Detail Item decide its role (comma separated, first role wins: cable, breaker, board). Symbols matching nothing are recognised by the parameters they carry."/>
                                <TextBlock Text="Cable symbols" FontWeight="SemiBold"/>
                                <TextBox x:Name="role_cable" Style="{StaticResource Field}" Margin="0,4,0,10"/>
                                <TextBlock Text="Breaker / isolator symbols" FontWeight="SemiBold"/>
                                <TextBox x:Name="role_breaker" Style="{StaticResource Field}" Margin="0,4,0,10"/>
                                <TextBlock Text="Board / equipment symbols" FontWeight="SemiBold"/>
                                <TextBox x:Name="role_equipment" Style="{StaticResource Field}" Margin="0,4,0,10"/>
                                <TextBlock Text="Ignore these symbols (panel details, interlocks, legends ...)" FontWeight="SemiBold"/>
                                <TextBox x:Name="role_ignore" Style="{StaticResource Field}" Margin="0,4,0,10"/>
                                <TextBlock Text="Name endings to ignore when there is no exact match  (regex, one per line)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Text="e.g. \s*\([A-Za-z0-9]{1,3}\)$ matches 'PP-01(E)' to model board 'PP-01' - always reported as a warning."/>
                                <TextBox x:Name="suffix_patterns" Style="{StaticResource Field}" Height="52" Margin="0,4,0,10" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="8,6" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Text="Spare keywords (in Feeds / Spare field)" FontWeight="SemiBold"/>
                                <TextBox x:Name="spare_keywords" Style="{StaticResource Field}" Margin="0,4,0,10"/>
                                <TextBlock Text="Board classification rules  (one per line:  LABEL = regular expression)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Tested on the panel name, then 'Family : Type', then the family Part Type. First match wins - keep SMDB above MDB."/>
                                <TextBox x:Name="class_rules" Style="{StaticResource Field}" Height="120" Margin="0,4,0,0" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" Padding="8,6" FontFamily="Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tolerances and options" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
                                    <RowDefinition Height="38"/><RowDefinition Height="38"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Load tolerance (%)" VerticalAlignment="Center"/>
                                <TextBox x:Name="tol_load" Grid.Column="1" Style="{StaticResource Field}"/>
                                <TextBlock Grid.Row="1" Text="Breaker rating tolerance (A)" VerticalAlignment="Center"/>
                                <TextBox x:Name="tol_rating" Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"/>
                                <TextBlock Grid.Row="2" Text="Cable size tolerance (mm²)" VerticalAlignment="Center"/>
                                <TextBox x:Name="tol_cable" Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"/>
                                <TextBlock Grid.Row="3" Text="SLD load text without unit is" VerticalAlignment="Center"/>
                                <ComboBox x:Name="load_unit" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Text="Max rows per section in the report" VerticalAlignment="Center"/>
                                <TextBox x:Name="max_rows" Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}"/>
                            </Grid>
                            <CheckBox x:Name="chk_multi_view" Margin="0,12,0,4"
                                      Content="Same board in different views is OK (overview + detail sheets)"/>
                            <CheckBox x:Name="chk_expect_all"
                                      Content="Expect every final circuit on the SLD (not only outgoing feeders)"/>
                            <CheckBox x:Name="chk_sections" Margin="0,4,0,0"
                                      Content="Same name + same family close together = one board made of sections"/>
                            <CheckBox x:Name="chk_links" Margin="0,4,0,0"
                                      Content="Also match equipment and circuits in loaded Revit links"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ===== footer ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="status_text" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#5C5C5C"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Click="on_cancel" Height="34"/>
                <Button Content="Run Check" Style="{StaticResource Accent}" Click="on_run"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
