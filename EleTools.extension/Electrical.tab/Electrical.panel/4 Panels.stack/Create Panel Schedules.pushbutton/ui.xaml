<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Panel Schedules" Width="820" Height="660" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#F4F6F8">
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5F6B7A"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7785"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Tick the panels that need a panel schedule and choose the template for each kind of panel. Panels that already have a schedule are shown greyed out and are never changed."/>

        <!-- search / filter / tick buttons -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="search_tb" Grid.Column="0" Height="26" VerticalContentAlignment="Center"
                     ToolTip="Search panel name or family / type - several words: all must appear"/>
            <ComboBox x:Name="show_cb" Grid.Column="1" Width="200" Margin="6,0,0,0"/>
            <Button x:Name="all_btn" Grid.Column="2" Content="Tick shown" Width="80" Margin="6,0,0,0"/>
            <Button x:Name="none_btn" Grid.Column="3" Content="Untick shown" Width="90" Margin="6,0,0,0"/>
        </Grid>

        <!-- list header -->
        <Grid Grid.Row="2" Margin="30,4,18,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Panel" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="1" Text="Family : Type" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="2" Text="Kind" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="3" Text="Schedule" Style="{StaticResource Head}"/>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#C9D1DA" BorderThickness="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="rows_sp" Margin="6,4"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="count_tb" Grid.Row="4" Margin="0,6,0,10" Foreground="#2F3B4C" FontWeight="Bold"/>

        <!-- templates per kind of panel -->
        <GroupBox Grid.Row="5" Header="Panel schedule template" Padding="8,6" Margin="0,0,0,10">
            <StackPanel>
                <Grid x:Name="branch_row" Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="branch_lbl" Text="Branch panels (Panelboard)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="branch_cb" Grid.Column="1"/>
                </Grid>
                <Grid x:Name="switch_row" Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="switch_lbl" Text="Switchboards" VerticalAlignment="Center"/>
                    <ComboBox x:Name="switch_cb" Grid.Column="1"/>
                </Grid>
                <Grid x:Name="data_row" Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="data_lbl" Text="Data panels (Other Panel)" VerticalAlignment="Center"/>
                    <ComboBox x:Name="data_cb" Grid.Column="1"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                           Text="Each list shows only the templates Revit accepts for that kind of panel. '&lt;Revit default&gt;' uses the default set in Manage &gt; Panel Schedule Templates."/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="report_btn" Content="Report only" Width="110" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="create_btn" Content="CREATE SCHEDULES" Width="160" Height="30" Margin="0,0,8,0"
                    FontWeight="Bold" Background="#2E7D32" Foreground="White"/>
            <Button x:Name="close_btn" Content="Close" Width="80" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
