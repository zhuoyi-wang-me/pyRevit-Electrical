<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update 3-Phase Circuit Length" Height="800" Width="1280" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#F4F4F4">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00695C"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Update 3-Phase Circuit Length" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Routes each 3-phase circuit along the connected cable trays (risers included) from the panel to the farthest device and writes the route as the circuit's Custom path, so Revit's circuit Length follows the tray. Not multiplied by 3. Trays are only read."
                       FontSize="12" Foreground="#777777" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 1 panels -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="1  PANELS  (their 3-phase circuits are routed)" Style="{StaticResource Head}"/>
                    <DockPanel Grid.Row="1">
                        <TextBlock Text="Search" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,6,4" Style="{StaticResource Cap}"/>
                        <TextBox x:Name="txtSearch" ToolTip="Filter the panel list (part of the name)"/>
                    </DockPanel>
                    <ListBox Grid.Row="2" x:Name="lstPanels" BorderBrush="#DDDDDD"/>
                    <DockPanel Grid.Row="3" LastChildFill="False">
                        <Button x:Name="btnAll" Content="All shown" DockPanel.Dock="Left"/>
                        <Button x:Name="btnNone" Content="None" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="lblPanels" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- 2 tray models -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="2  CABLE TRAY MODEL  (host / loaded links with trays)" Style="{StaticResource Head}"/>
                    <ListBox Grid.Row="1" x:Name="lstModels" BorderBrush="#DDDDDD"/>
                    <TextBlock Grid.Row="2" x:Name="lblModels" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Cap}"/>
                </Grid>
            </Border>

            <!-- 3 options -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="3  OPTIONS" Style="{StaticResource Head}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Panel / device to tray - plan (mm)" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtPlan"/>
                            <TextBlock Grid.Row="1" Text="Panel / device to tray - height (mm)" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtDrop"/>
                            <TextBlock Grid.Row="2" Text="Join open tray ends up to (mm)" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtGap"/>
                            <TextBlock Grid.Row="3" Text="Join riser cut at slab up to (mm)" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtRiserGap"/>
                            <TextBlock Grid.Row="4" Text="Electrical room: tray to riser (mm)" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtRoomReach"/>
                        </Grid>
                        <CheckBox x:Name="chkRooms" Content="Use risers in the panel's electrical room"
                                  ToolTip="Rooms are read from the host and the loaded ARC links. Vertical trays inside the panel's room serve every level."/>
                        <CheckBox x:Name="chkPanelTop" Content="Trays running above a panel can start the route"
                                  ToolTip="Main switchboards: cables go up out of the top of the line-up into the trays above it, anywhere along its length."/>
                        <CheckBox x:Name="chkConnections" Content="Add panel / device drops to the total"/>
                        <CheckBox x:Name="chkUpdate" Content="Update Revit circuit length (Custom path)"/>
                        <TextBlock Text="Unticked = report only, the model is not changed." Style="{StaticResource Cap}" Margin="20,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- results -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock Text="RESULTS" Style="{StaticResource Head}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="cmbFilter" Width="160" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="lblSummary" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Cap}"/>
                    <Button x:Name="btnSelect" Content="Select circuit in Revit" DockPanel.Dock="Right"/>
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="gridResults" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Extended" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#DDDDDD">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="SUCCESS">
                                    <Setter Property="Background" Value="#E3F4E4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="CALCULATED">
                                    <Setter Property="Background" Value="#FFF3CD"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="FAILED">
                                    <Setter Property="Background" Value="#FDE2E2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Panel" Binding="{Binding Panel}" Width="150"/>
                        <DataGridTextColumn Header="Circuit" Binding="{Binding Circuit}" Width="70"/>
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="170"/>
                        <DataGridTextColumn Header="Horizontal m" Binding="{Binding Horizontal}" Width="85"/>
                        <DataGridTextColumn Header="Riser m" Binding="{Binding Riser}" Width="65"/>
                        <DataGridTextColumn Header="Other m" Binding="{Binding Other}" Width="65"/>
                        <DataGridTextColumn Header="Drops m" Binding="{Binding Drops}" Width="65"/>
                        <DataGridTextColumn Header="Total m" Binding="{Binding Total}" Width="70" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Revit before m" Binding="{Binding Before}" Width="90"/>
                        <DataGridTextColumn Header="Revit after m" Binding="{Binding After}" Width="85"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/>
                        <DataGridTextColumn Header="Reason / note" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="lblStatus" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Cap}"/>
            <Button x:Name="btnClose" Content="Close" DockPanel.Dock="Right" Width="90"/>
            <Button x:Name="btnLog" Content="Open log" DockPanel.Dock="Right"/>
            <Button x:Name="btnRun" Content="Run" DockPanel.Dock="Right" Width="120" FontWeight="Bold"
                    Background="#00897B" Foreground="White"/>
        </DockPanel>
    </Grid>
</Window>
