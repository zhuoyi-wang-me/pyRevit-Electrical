<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Schedule Sync" Height="520" Width="920" MinHeight="350" MinWidth="700"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" MinHeight="20" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="RefreshButton" Content="Refresh" Width="105" Margin="0,0,8,0" />
                <Button x:Name="UpdateSelectedButton" Content="Update Selected" Width="125" Margin="0,0,8,0" />
                <Button x:Name="UpdateAllButton" Content="Update All Mismatches" Width="155" Margin="0,0,8,0" />
                <Button x:Name="CloseButton" Content="Close" Width="85" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="PanelGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Panel Name" Binding="{Binding PanelName}" Width="*" />
                <DataGridTextColumn Header="Current Schedule Name" Binding="{Binding ScheduleName}" Width="*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
