<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElecAutoCircuit - Automated Electrical Circuiting"
        Width="1120" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="4,6,16,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="Label" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,8,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#FF5A6572"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFE1E5EA"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF6F8FA"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- ============ bottom bar ============ -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Close" Click="btn_close_click"/>
            <Button DockPanel.Dock="Right" Content="Reset to Defaults" Click="btn_reset_click"/>
            <Button DockPanel.Dock="Right" Content="Import..." Click="btn_import_settings_click"/>
            <Button DockPanel.Dock="Right" Content="Export..." Click="btn_export_settings_click"/>
            <Button DockPanel.Dock="Right" Content="Save Settings" FontWeight="SemiBold" Click="btn_save_click"/>
            <TextBlock x:Name="status_text" VerticalAlignment="Center" Margin="6,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <TabControl>
            <!-- ============ 1. Circuit rules ============ -->
            <TabItem Header="  Circuit Rules  ">
                <DockPanel>
                    <GroupBox Header="Grouping and room merging" DockPanel.Dock="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="Minimum devices before room merging"/>
                            <TextBox x:Name="tb_min_fixtures" Grid.Column="1"/>
                            <TextBlock Style="{StaticResource Label}" Grid.Column="2" Margin="24,0,8,0" Text="Max merge distance (m, 0 = unlimited)"/>
                            <TextBox x:Name="tb_merge_distance" Grid.Column="3"/>

                            <CheckBox x:Name="cb_allow_merge" Grid.Row="1" Content="Allow room merging (adjacent first, then nearest)"/>
                            <CheckBox x:Name="cb_merge_tails" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Margin="24,6,6,6"
                                      Content="Also merge partial 'tail' circuits of large rooms"/>

                            <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Max panel utilization (%)"/>
                            <TextBox x:Name="tb_max_util" Grid.Row="2" Grid.Column="1"/>
                            <CheckBox x:Name="cb_prefer_level" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Margin="24,6,6,6"
                                      Content="Prefer panels on the same level"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Room and classification detection" DockPanel.Dock="Top">
                        <WrapPanel>
                            <CheckBox x:Name="cb_linked_rooms" Content="Use rooms from linked models"/>
                            <CheckBox x:Name="cb_spaces" Content="Fall back to MEP Spaces"/>
                            <CheckBox x:Name="cb_read_family" Content="Read Load Classification from family connectors (slower, cached per family)"/>
                        </WrapPanel>
                    </GroupBox>
                    <DockPanel DockPanel.Dock="Top" Margin="4,6,4,0">
                        <Button DockPanel.Dock="Right" Content="Remove Rule" Click="btn_remove_rule_click"/>
                        <Button DockPanel.Dock="Right" Content="Add Rule" Click="btn_add_rule_click"/>
                        <TextBlock Text="Circuit rules  (0 = no limit)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Defaults follow common NEC 120 V practice: 1800 VA = 15 A x 120 V; NEC 220.14(I) counts 180 VA per receptacle yoke; fixture-count caps are design conventions, not code requirements. For 230 V IEC projects raise the VA limits to suit the protective device (e.g. 16 A x 230 V = 3680 VA before diversity/derating). Dedicated = one device per circuit. DedicatedAboveVA forces a dedicated circuit above that load (Equipment: 1500 VA)."/>
                    <DataGrid x:Name="rules_grid"/>
                </DockPanel>
            </TabItem>

            <!-- ============ 2. Classification mapping ============ -->
            <TabItem Header="  Load Classification Mapping  ">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,4,4,0">
                        <Button DockPanel.Dock="Right" Content="Sync with Project" Click="btn_import_classes_click"/>
                        <Button DockPanel.Dock="Right" Content="Remove Selected" Click="btn_remove_map_click"/>
                        <Button DockPanel.Dock="Right" Content="Add Row" Click="btn_add_map_click"/>
                        <TextBlock Text="Project Load Classifications  -&gt;  Panel Type  -&gt;  Circuit Rule" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Rows are the Electrical Load Classifications defined in THIS project (Manage &gt; MEP Settings &gt; Electrical Settings &gt; Load Classifications) and are re-synced every time the tool opens. Each device's classification is read from the project by placing it on a temporary circuit that is always rolled back. New classifications get a suggested panel type - review them. Leave Panel Type blank to exclude a classification. InProject = false marks saved rows no longer in the project; wildcard rows (e.g. 'Lighting*') can be added manually."/>
                    <DataGrid x:Name="map_grid"/>
                </DockPanel>
            </TabItem>

            <!-- ============ 3. Regions ============ -->
            <TabItem Header="  Region Settings  ">
                <DockPanel>
                    <GroupBox Header="Distribution regions (Filled Regions drawn in plan views)" DockPanel.Dock="Top">
                        <WrapPanel>
                            <TextBlock Style="{StaticResource Label}" Text="Filled region type name starts with"/>
                            <TextBox x:Name="tb_region_prefix" Width="140"/>
                            <TextBlock Style="{StaticResource Label}" Margin="16,0,8,0" Text="Region name from"/>
                            <ComboBox x:Name="cmb_region_name_source" Width="190" Margin="4,3" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Comments parameter"/>
                                <ComboBoxItem Content="Filled region type name"/>
                            </ComboBox>
                            <CheckBox x:Name="cb_region_level_filter" Margin="16,6,16,6" Content="Region applies only to its view's level"/>
                            <CheckBox x:Name="cb_cross_region" Content="Allow cross-region circuiting (fallback only)"/>
                            <Button Content="Scan Regions and Panels" Click="btn_scan_regions_click"/>
                        </WrapPanel>
                    </GroupBox>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}"
                               Text="Panels are assigned to the region they sit in. To override, type panel names (comma-separated) in OverridePanels: listed panels then serve ONLY those regions. Devices outside every region belong to &lt;No Region&gt; and can only use panels also outside every region (or listed against &lt;No Region&gt;)."/>
                    <DataGrid x:Name="region_grid"/>
                </DockPanel>
            </TabItem>

            <!-- ============ 4. Execution ============ -->
            <TabItem Header="  Execution  ">
                <DockPanel>
                    <GroupBox Header="Circuiting scope" DockPanel.Dock="Top">
                        <StackPanel>
                            <WrapPanel>
                                <RadioButton x:Name="rb_scope_all" GroupName="scope" Margin="4,6,20,6" VerticalAlignment="Center"
                                             Content="Whole model (all distribution regions)"/>
                                <RadioButton x:Name="rb_scope_selected" GroupName="scope" Margin="4,6,20,6" VerticalAlignment="Center"
                                             FontWeight="SemiBold" Content="ONLY inside selected filled region(s) - everything else is skipped"/>
                                <Button Content="Pick Filled Region(s) in View..." Click="btn_pick_regions_click"/>
                                <Button Content="Clear" Click="btn_clear_regions_click"/>
                            </WrapPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Include a device when"/>
                                <ComboBox x:Name="cmb_scope_inclusion" Width="360" Margin="4,3" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="the device itself is inside the region"/>
                                    <ComboBoxItem Content="its room's location point is inside (keeps rooms whole)"/>
                                </ComboBox>
                            </WrapPanel>
                            <TextBlock x:Name="txt_scope" Style="{StaticResource Hint}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Rooms, devices and panels outside the selected region(s) are not read, not circuited and not reported. Each selected region is its own zone. Panels must sit inside a selected region, or be listed for it under Region Settings &gt; OverridePanels. The region applies to the level of the plan it was drawn in; untick 'Region applies only to its view's level' (Region Settings) to apply it to every level. Tip: select the filled regions before clicking Auto Circuit."/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,4">
                        <Button Content="Preview (no changes)" Click="btn_preview_click"/>
                        <Button Content="Create Circuits" FontWeight="SemiBold" Click="btn_create_click"/>
                        <Separator Width="16" Visibility="Hidden"/>
                        <Button Content="Export CSV..." Click="btn_export_csv_click"/>
                        <Button Content="Export Excel..." Click="btn_export_xlsx_click"/>
                        <Button Content="Select Uncircuited in Model" Click="btn_select_uncircuited_click"/>
                    </WrapPanel>
                    <GroupBox Header="Options" DockPanel.Dock="Top">
                        <WrapPanel>
                            <CheckBox x:Name="cb_all_or_nothing" Content="All-or-nothing (roll back the whole run if any circuit fails)"/>
                            <CheckBox x:Name="cb_auto_report" Content="Auto-export CSV + Excel report after creating circuits to"/>
                            <TextBox x:Name="tb_report_folder" Width="300"/>
                            <Button Content="Browse..." Click="btn_browse_report_click"/>
                        </WrapPanel>
                    </GroupBox>
                    <TextBlock x:Name="txt_summary" DockPanel.Dock="Top" Margin="6,6" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="Run a preview to see the proposed circuits."/>
                    <DataGrid x:Name="preview_grid" IsReadOnly="True"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
