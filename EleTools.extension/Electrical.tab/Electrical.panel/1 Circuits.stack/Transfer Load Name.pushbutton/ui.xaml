<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Load Name"
        Height="860" Width="1380"
        MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#FFF2F4F7"
        Foreground="#FF1D2733"
        FontFamily="Segoe UI"
        FontSize="12.5"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- No x:Class attribute. pyRevit loads this with wpf.LoadComponent,
         which binds x:Name fields onto the Python window instance; a declared
         code-behind class conflicts with that.

         No event handlers here either: every handler is attached in
         TransferLoadNameWindow._wire_events (script.py). IronPython's XAML
         reader cannot bind handlers inside a DataTemplate nor attached
         events, so they must be wired in code anyway. Keep the x:Name of
         each control when restyling.

         The styles are the same set as the other EleTools windows. Icons are
         "Segoe MDL2 Assets" glyphs (ships with Windows 10/11). -->

    <Window.Resources>
        <!-- ============================ Palette ============================ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0B6BCB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF0958A8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF074785" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE8F1FC" />
        <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#FFBBD6F5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1D2733" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF667585" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFDCE2E9" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#FFB9C3CE" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FFF6F8FA" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FFEEF2F6" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE6EAEF" />
        <SolidColorBrush x:Key="GoBrush" Color="#FF16845B" />
        <SolidColorBrush x:Key="GoHoverBrush" Color="#FF116D4A" />
        <SolidColorBrush x:Key="GoPressedBrush" Color="#FF0C573B" />

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0F2A47" Offset="0" />
            <GradientStop Color="#FF1A4D7C" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ============================ Text ============================== -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ============================ Cards ============================= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- Rounded shell for a text box that carries an icon / clear button -->
        <Style x:Key="InputShell" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ Buttons =========================== -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="label"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="icon" Property="Margin" Value="0" />
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <!-- Filled blue: the main action of a panel -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled green: EXPORT -->
        <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GoBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="15"
                                           Margin="0,1,10,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF8A97A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent button for the dark header band -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless square icon button (clear search etc.) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- ============================ Text boxes ======================== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text box with no chrome: lives inside an InputShell border -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Check / radio ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#FF94A1AE"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Path x:Name="tick"
                                          Data="M2.5,7 L5.8,10.2 L11.5,3.8"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                    <Rectangle x:Name="dash"
                                               Width="8"
                                               Height="2"
                                               Fill="White"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="17" Height="17" VerticalAlignment="Center">
                                <Ellipse x:Name="ring"
                                         Fill="White"
                                         Stroke="#FF94A1AE"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="dot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button drawn as one segment of a segmented switch -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Combo box ========================= -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,1,11,0"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Stroke="#FF667585"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF667585" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0B6BCB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="White"
                                        BorderBrush="{StaticResource LineStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer Margin="0,3">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ List box ========================== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer Margin="0,2" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Data grid ========================= -->
        <Style x:Key="ColumnGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Path x:Name="sort"
                                          Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="M0,4 L4,0 L8,4"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.6"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource ColumnGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripper}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                                <Setter TargetName="sort" Property="Data" Value="M0,0 L4,4 L8,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFAFBFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEDF0F3" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <!-- ============================ Cards as GroupBox / Expander ====== -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border x:Name="bd"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,14">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"
                                                  ContentSource="Header"
                                                  Margin="0,0,0,8"
                                                  TextElement.FontSize="13.5"
                                                  TextElement.FontWeight="SemiBold" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10,14,14">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent" Height="24">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.FontSize="13.5"
                                                                  TextElement.FontWeight="SemiBold" />
                                                <Path x:Name="chevron"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,2,0"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#FF667585"
                                                      StrokeThickness="1.6" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chevron" Property="Data" Value="M0,4 L4,0 L8,4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Wizard steps ====================== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Height="50" Margin="0,0,26,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="badge"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{StaticResource TrackBrush}">
                                    <TextBlock x:Name="badgeText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="9,0,0,0"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="line"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="White" />
                                <Setter TargetName="line" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal"
                                            IsItemsHost="True"
                                            Margin="20,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- Shared template for both facet lists (IsSelected is two-way). -->
        <DataTemplate x:Key="FacetTemplate">
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      ToolTip="{Binding Label, Mode=OneWay}">
                <TextBlock Text="{Binding Display, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel>
                <Button x:Name="btn_refresh" DockPanel.Dock="Right" Style="{StaticResource HeaderButton}"
                        Tag="&#xE72C;" Content="Refresh from model" VerticalAlignment="Center"
                        ToolTip="Read the circuits and parameter values again" />
                <Border Width="38" Height="38" CornerRadius="9" Background="#26FFFFFF" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;" FontSize="19"
                               Foreground="White" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Transfer Load Name" Foreground="White" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="doc_name" Text="Copy a text parameter into each circuit's Load Name"
                               Foreground="#FFC3D5E8" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== Left: the four steps ====================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0" Padding="0,0,4,0">
                <StackPanel>

                    <!-- 1 Circuits -->
                    <GroupBox Header="1   Circuits to process">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="scope_selection" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="scope" Content="Selection" />
                                    <RadioButton x:Name="scope_view" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="scope" Content="Active view" />
                                    <RadioButton x:Name="scope_model" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="scope" Content="Whole model" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="FIND CIRCUITS THROUGH" Margin="0,12,0,6" />
                            <UniformGrid Columns="2">
                                <CheckBox x:Name="via_circuits" IsChecked="True" Content="Circuits" Margin="0,0,0,8"
                                          ToolTip="Circuits themselves (selected in the System Browser, or every circuit of the model)" />
                                <CheckBox x:Name="via_fixtures" IsChecked="True" Content="Electrical fixtures" Margin="0,0,0,8"
                                          ToolTip="The circuits the electrical fixtures are connected to" />
                                <CheckBox x:Name="via_equipment" IsChecked="True" Content="Electrical equipment"
                                          ToolTip="Circuits of panels, switchboards, transformers ... (see the choice below)" />
                                <CheckBox x:Name="via_other" IsChecked="True" Content="Other devices"
                                          ToolTip="Lighting fixtures and devices, data, fire alarm, communication, security, nurse call, telephone devices and mechanical equipment" />
                            </UniformGrid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="FOR ELECTRICAL EQUIPMENT, TAKE" />
                            <ComboBox x:Name="equip_mode" />

                            <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                                <TextBlock x:Name="scope_note" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentPressedBrush}" />
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2 Filter by value -->
                    <GroupBox Header="2   Filter by parameter value  (optional)" Margin="0,10,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="flt_target_circuit" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="flt_target" Content="On the circuit" />
                                    <RadioButton x:Name="flt_target_element" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="flt_target" Content="On a connected element" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="PARAMETER" />
                            <Border Style="{StaticResource InputShell}" Height="28" Margin="0,0,0,5"
                                    ToolTip="Type to narrow the parameter list below">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="9,0,7,0" />
                                    <TextBox x:Name="flt_param_filter" Style="{StaticResource BareTextBox}" Margin="0,0,8,0" />
                                </DockPanel>
                            </Border>
                            <ComboBox x:Name="flt_param" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="CONDITION" Margin="0,0,0,4" />
                                    <ComboBox x:Name="flt_op" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="VALUE" Margin="0,0,0,4" />
                                    <TextBox x:Name="flt_value" ToolTip="Not case sensitive" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="... OR PICK A VALUE FOUND IN THE MODEL" />
                            <DockPanel>
                                <Button x:Name="btn_flt_clear" DockPanel.Dock="Right" Tag="&#xE894;" Content="Clear"
                                        Margin="8,0,0,0" ToolTip="Remove the filter" />
                                <ComboBox x:Name="flt_values" />
                            </DockPanel>

                            <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                                <TextBlock x:Name="flt_note" TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentPressedBrush}" />
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3 Source -->
                    <GroupBox Header="3   Read the text from" Margin="0,10,0,0">
                        <StackPanel>
                            <Border Style="{StaticResource SegmentTrack}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="mode_circuit" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="mode" Content="The circuit" />
                                    <RadioButton x:Name="mode_element" Style="{StaticResource Segment}" Padding="6,0"
                                                 GroupName="mode" Content="A connected element" />
                                </UniformGrid>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="SOURCE PARAMETER  (text parameters)" />
                            <Border Style="{StaticResource InputShell}" Height="28" Margin="0,0,0,5"
                                    ToolTip="Type to narrow the parameter list below">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12"
                                               Foreground="{StaticResource MutedBrush}" Margin="9,0,7,0" />
                                    <TextBox x:Name="param_filter" Style="{StaticResource BareTextBox}" Margin="0,0,8,0" />
                                </DockPanel>
                            </Border>
                            <ComboBox x:Name="param_combo" />
                            <TextBlock x:Name="param_note" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Instance value first, then the type's. With several elements on a circuit the first non-empty value wins (lowest element id)." />
                        </StackPanel>
                    </GroupBox>

                    <!-- 3b Narrow connected elements -->
                    <Expander x:Name="element_filter_group" Header="Narrow the connected elements" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,8,0,4">
                                <Button x:Name="btn_cat_none" DockPanel.Dock="Right" Content="None" Height="22" Padding="8,0" FontSize="11.5" Margin="4,0,0,0" />
                                <Button x:Name="btn_cat_all" DockPanel.Dock="Right" Content="All" Height="22" Padding="8,0" FontSize="11.5" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CATEGORIES" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox x:Name="cat_list" Height="118" ItemTemplate="{StaticResource FacetTemplate}" />

                            <DockPanel Margin="0,10,0,4">
                                <Button x:Name="btn_type_none" DockPanel.Dock="Right" Content="None" Height="22" Padding="8,0" FontSize="11.5" Margin="4,0,0,0" />
                                <Button x:Name="btn_type_all" DockPanel.Dock="Right" Content="All" Height="22" Padding="8,0" FontSize="11.5" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="FAMILY : TYPE" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="type_filter" Height="26" Margin="0,0,0,5"
                                     ToolTip="Search family and type names. All / None act on the types listed." />
                            <ListBox x:Name="type_list" Height="150" ItemTemplate="{StaticResource FacetTemplate}" />
                            <TextBlock x:Name="facet_note" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- 4 Options -->
                    <GroupBox Header="4   Options" Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox x:Name="opt_overwrite" Content="Overwrite a Load Name that is already filled in" />
                            <CheckBox x:Name="opt_trim" IsChecked="True" Content="Trim leading / trailing spaces" Margin="0,8,0,0" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="PREFIX" Margin="0,0,0,4" />
                                    <TextBox x:Name="opt_prefix" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="SUFFIX" Margin="0,0,0,4" />
                                    <TextBox x:Name="opt_suffix" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- ====================== Right: preview ====================== -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="14,12,14,12">
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="12"
                                Padding="12,4" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="count_text" Text="0 to update" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPressedBrush}" />
                        </Border>
                        <CheckBox x:Name="opt_changes_only" DockPanel.Dock="Right" Content="Changes only"
                                  VerticalAlignment="Center" Margin="14,0,0,0" />
                        <Border Style="{StaticResource InputShell}"
                                ToolTip="Space-separated terms, all must match. Searches circuit, panel, current value, new value, source element, category and action. APPLY only touches the rows left in the list.">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE721;"
                                           Foreground="{StaticResource MutedBrush}" Margin="10,0,8,0" />
                                <Button x:Name="btn_search_clear" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        Tag="&#xE711;" Margin="0,0,2,0" ToolTip="Clear search" />
                                <Grid>
                                    <TextBox x:Name="row_search" Style="{StaticResource BareTextBox}" />
                                    <TextBlock Text="Search the preview...   e.g.  DB-01 lighting"
                                               Foreground="#FF98A4B0" Margin="3,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=row_search}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="preview_grid"
                              BorderThickness="0,1,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              ToolTip="Double-click a row to select that circuit in Revit">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Circuit"    Binding="{Binding Circuit}"  Width="0.8*" MinWidth="70" />
                            <DataGridTextColumn Header="Panel"      Binding="{Binding Panel}"    Width="0.9*" MinWidth="70" />
                            <DataGridTextColumn Header="Current Load Name" Binding="{Binding Current}"  Width="1.5*" />
                            <DataGridTextColumn Header="New Load Name"     Binding="{Binding NewValue}" Width="1.5*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Read from"  Binding="{Binding Source}"   Width="1.3*" />
                            <DataGridTextColumn Header="Category"   Binding="{Binding Category}" Width="1.1*" />
                            <DataGridTemplateColumn Header="Action" Width="178" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBack}" CornerRadius="10" Padding="9,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                       FontWeight="SemiBold" FontSize="11.5" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <!-- IsCancel is deliberately omitted: it closes the window by
                     setting DialogResult, which would race the Click handler's
                     own Close() call. Esc is handled by pyRevit's WPFWindow. -->
                <Button x:Name="btn_apply" DockPanel.Dock="Right" Style="{StaticResource GoButton}"
                        Tag="&#xE73E;" Content="APPLY" MinWidth="170" Margin="8,0,0,0"
                        ToolTip="Write the new Load Names of the rows listed. Changes the model (one undoable transaction)." />
                <Button x:Name="btn_cancel" DockPanel.Dock="Right" Content="Cancel" Width="90" Height="38" />
                <TextBlock x:Name="status_text" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0" Text="Ready." />
            </DockPanel>
        </Border>
    </Grid>
</Window>
