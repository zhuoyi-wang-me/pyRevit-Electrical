<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Data by Location – Electrical"
        Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip">

    <!-- Styles are shared with ui.xaml (script.py copies its Window.Resources here) -->
    {{RESOURCES}}

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Background="#3D2C6B" Padding="18,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Room Data by Location – Electrical" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Writes the Room / Space each electrical fixture or device sits in to the element itself"
                               Foreground="#D9D2EC" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock x:Name="summary_tb" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="White" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ================= CONTENT ================= -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- STEP 1: what to locate -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Elements" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <TextBlock Text="Categories" Style="{StaticResource Hint}" Margin="0,10,0,3"/>
                            <ListBox x:Name="cat_list" MaxHeight="110" BorderBrush="#DDE3EA"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                            <!-- family : type filter of the ticked categories -->
                            <TextBlock Text="Family : Type  (only ticked types are used)" Style="{StaticResource Hint}" Margin="0,10,0,3"/>
                            <Border BorderBrush="#C9D1DA" BorderThickness="1" CornerRadius="4" Background="White">
                                <Grid>
                                    <TextBlock x:Name="type_search_hint" Text="Filter the list: family or type name..."
                                               Foreground="#9AA5B1" Margin="9,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                    <TextBox x:Name="type_search_tb" Height="26" BorderThickness="0" Background="Transparent"
                                             VerticalContentAlignment="Center" Padding="6,0"/>
                                </Grid>
                            </Border>
                            <Grid Margin="0,6,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="btn_types_all" Content="Tick shown" Style="{StaticResource Btn}" Padding="8,3"/>
                                    <Button x:Name="btn_types_none" Content="Untick shown" Style="{StaticResource Btn}" Padding="8,3"/>
                                </StackPanel>
                                <TextBlock x:Name="type_count_tb" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource Hint}"/>
                            </Grid>
                            <ListBox x:Name="type_list" Height="170" BorderBrush="#DDE3EA"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Scope" Style="{StaticResource Hint}" Margin="0,10,0,3"/>
                            <RadioButton x:Name="loc_scope_all" GroupName="locscope" Content="Entire model" Margin="0,2"/>
                            <RadioButton x:Name="loc_scope_view" GroupName="locscope" Content="Active view" Margin="0,2"/>
                            <RadioButton x:Name="loc_scope_sel" GroupName="locscope" Content="Current Revit selection" Margin="0,2"/>
                            <TextBlock Text="Look for" Style="{StaticResource Hint}" Margin="0,10,0,3"/>
                            <ComboBox x:Name="prefer_cb"
                                      ToolTip="Which is used when an element is inside both a Room and an MEP Space."/>
                            <Button x:Name="btn_find" Content="Find rooms" Style="{StaticResource PrimaryBtn}"
                                    Margin="0,12,0,4" HorizontalAlignment="Stretch"/>
                            <TextBlock x:Name="find_info_tb" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </Border>

                    <!-- STEP 2: parameters -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Choose target parameters" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                       Text="Writable text parameters found on the elements (on the selection when the scope is 'Current Revit selection'). [9/12 types] = how many family types have the parameter. Leave a row on &lt;Do not write&gt; to skip it. Room Number and Room Name set to the SAME parameter are written together in the format chosen in step 3 (e.g. 101 - Lobby)."/>
                            <StackPanel x:Name="mapping_panel">
                                {{MAPPING_ROWS}}
                            </StackPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="btn_automatch" Content="Auto-match by name" Style="{StaticResource Btn}"/>
                                <Button x:Name="btn_clearmap" Content="Clear mapping" Style="{StaticResource Btn}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- STEP 3: options -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Options" Style="{StaticResource StepTitle}"/>
                            </StackPanel>
                            <CheckBox x:Name="only_empty_cb" Content="Only fill parameters that are empty"
                                      ToolTip="Values typed by hand are kept."/>
                            <CheckBox x:Name="clear_cb" Content="Clear the parameters of elements with no room"
                                      ToolTip="Off: elements outside every room are left as they are."/>
                            <CheckBox x:Name="dryrun_cb" Content="Report only - do not modify the model"/>
                            <TextBlock Text="Room Number + Name format" Style="{StaticResource Hint}" Margin="0,8,0,3"/>
                            <ComboBox x:Name="room_format_cb" MaxDropDownHeight="420"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RESULT -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Room found for each element" Style="{StaticResource StepTitle}"/>
                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#C9D1DA" BorderThickness="1" CornerRadius="4" Background="White">
                            <Grid>
                                <TextBlock x:Name="search_hint" Text="Search mark, family, category, room number, room name or ID..."
                                           Foreground="#9AA5B1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="search_tb" Height="28" BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" Padding="6,0"/>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="only_missing_cb" Grid.Column="1" Margin="12,0,0,0"
                                  Content="Only elements without a room"/>
                    </Grid>
                    <DataGrid x:Name="loc_grid" Grid.Row="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF1F4" BorderBrush="#DDE3EA"
                              RowHeight="26" AlternatingRowBackground="#FAFBFC"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F3F5F8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="6,5"/>
                                <Setter Property="BorderBrush" Value="#DDE3EA"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                            <DataGridTextColumn Header="Family : Type" Binding="{Binding Element}" Width="2*"/>
                            <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="70"/>
                            <DataGridTextColumn Header="Room number" Binding="{Binding Number}" Width="95"/>
                            <DataGridTextColumn Header="Room name" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Found in" Binding="{Binding Source}" Width="140"/>
                            <DataGridTextColumn Header="Will be written" Binding="{Binding Preview}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#3D2C6B"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="ToolTip" Value="{Binding Preview}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock x:Name="count_tb" FontWeight="SemiBold" Foreground="#5B3F9E" VerticalAlignment="Center"/>
                        <TextBlock x:Name="visible_count_tb" HorizontalAlignment="Right" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btn_back" Grid.Column="0" Content="◀  Systems" Style="{StaticResource Btn}" Margin="0,0,12,0"
                        ToolTip="Back to the system picker. Settings of this window are saved."/>
                <TextBlock x:Name="status_tb" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Hint}" FontSize="12"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_cancel" Content="Cancel" Style="{StaticResource Btn}" IsCancel="True"/>
                    <Button x:Name="btn_run" Content="Write room data" Style="{StaticResource PrimaryBtn}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
