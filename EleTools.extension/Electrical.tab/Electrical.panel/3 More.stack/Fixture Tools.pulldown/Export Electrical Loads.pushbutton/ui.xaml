<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Electrical Load Report" Width="1100" Height="800" MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13" Foreground="#1E293B">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1E293B"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0F766E"/>
      <Setter Property="BorderBrush" Value="#0F766E"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="20,8"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="IsTextSearchEnabled" Value="True"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,18,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,2,18,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="#0F2A44" Padding="22,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Electrical Load Report" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Export loads by panel and load classification to Excel" Foreground="#A5B4C8" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock x:Name="DocTitleText" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="ModelStatsText" Foreground="#A5B4C8" FontSize="12" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid x:Name="BodyGrid" Grid.Row="1" Margin="16,16,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="370"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Panels -->
      <Border x:Name="PanelCard" Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="1 · Panels" Style="{StaticResource H}"/>
          <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" ToolTip="Filter panels by name"/>
            <TextBlock x:Name="SearchHint" Text="Search panels…" Foreground="#94A3B8" Margin="9,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
          <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="PrefixFilter" ToolTip="Panel type, taken from the letters at the start of the panel name"/>
            <CheckBox x:Name="HideEmptyPanels" Grid.Column="1" Content="Only with matching circuits" Margin="10,0,0,0"
                      IsChecked="True" ToolTip="Hide panels that have no circuits matching the phase filter"/>
          </Grid>
          <ListBox x:Name="PanelList" Grid.Row="3" BorderBrush="#E2E8F0" Background="#F8FAFC"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PanelCountText" VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="SelectVisibleButton" Content="Select shown" Style="{StaticResource Small}" Margin="0,0,6,0"/>
              <Button x:Name="ClearVisibleButton" Content="Clear shown" Style="{StaticResource Small}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- Options -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="2 · Source" Style="{StaticResource H}"/>
              <WrapPanel Margin="0,0,0,10">
                <RadioButton x:Name="ModeCircuited" GroupName="Mode" IsChecked="True"
                             Content="Circuited loads (by panel / circuit)"/>
                <RadioButton x:Name="ModeDirect" GroupName="Mode"
                             Content="Direct from a load parameter (no circuits needed)"/>
                <RadioButton x:Name="ModePanels" GroupName="Mode"
                             Content="Panel loads only (no fixtures)"
                             ToolTip="Exports one sheet: Revit's own load of each ticked panel per load classification, with Total Connected and Total Demand - the same numbers as an Electrical Equipment schedule. No fixture is read and no fixture sheet is written."/>
              </WrapPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Element scope" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="ScopeCombo" ToolTip="Selection may contain loads, circuits or panels"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Phase filter" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="PhaseCombo"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Load categories" Style="{StaticResource Lbl}" Margin="0,10,0,0"/>
              <WrapPanel>
                <CheckBox x:Name="CatElectricalFixtures" Content="Electrical Fixtures" IsChecked="True"/>
                <CheckBox x:Name="CatMechanicalEquipment" Content="Mechanical Equipment"/>
                <CheckBox x:Name="CatLightingFixtures" Content="Lighting Fixtures"/>
              </WrapPanel>
              <Grid x:Name="DirectPanel" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Direct load parameter (apparent power)" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="DirectParamCombo"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="If the parameter has no units, values are in" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="DirectUnitCombo" ToolTip="Ignored for parameters with an Electrical Power / Apparent Power type"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="3 · Classification &amp; identifiers" Style="{StaticResource H}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Load classification source" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="ClassificationCombo"
                            ToolTip="If the chosen parameter is empty, the connector's load classification is used"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Identifier parameter (default)" Style="{StaticResource Lbl}"/>
                  <ComboBox x:Name="IdentifierCombo"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Identifier rules (first match wins)" Style="{StaticResource Lbl}" Margin="0,12,0,4"/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="If classification contains" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="Rule1Text" Grid.Column="1"/>
                <TextBlock Grid.Column="2" Text="use" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <ComboBox x:Name="Rule1Combo" Grid.Column="3"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="If classification contains" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="Rule2Text" Grid.Column="1"/>
                <TextBlock Grid.Column="2" Text="use" VerticalAlignment="Center" Margin="10,0,8,0"/>
                <ComboBox x:Name="Rule2Combo" Grid.Column="3"/>
              </Grid>
              <TextBlock Text="Leave a rule's text empty to disable it." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="4 · Report" Style="{StaticResource H}"/>
              <TextBlock Text="Layout" Style="{StaticResource Lbl}"/>
              <WrapPanel>
                <CheckBox x:Name="GroupByPanel" Content="One sheet per panel" IsChecked="True"/>
                <CheckBox x:Name="GroupByClassification" Content="Aggregate by classification" IsChecked="True"
                          ToolTip="Unticked: one row per load element"/>
                <CheckBox x:Name="SumByIdentifier" Content="Sum Load Data by identifier" IsChecked="True"/>
                <CheckBox x:Name="IncludeCircuit" Content="Circuit number" IsChecked="True"/>
              </WrapPanel>
              <TextBlock Text="Columns" Style="{StaticResource Lbl}" Margin="0,8,0,4"/>
              <WrapPanel>
                <CheckBox x:Name="IncludeCount" Content="Count" IsChecked="True"/>
                <CheckBox x:Name="IncludeConnected" Content="Connected (kW)" IsChecked="True"/>
                <CheckBox x:Name="IncludeDemand" Content="Demand" IsChecked="True"/>
                <CheckBox x:Name="IncludeApparent" Content="Apparent (kVA)" IsChecked="True"/>
              </WrapPanel>
              <TextBlock Text="Extra sheets" Style="{StaticResource Lbl}" Margin="0,8,0,4"/>
              <WrapPanel>
                <CheckBox x:Name="IncludePanelMatrix" Content="Fixture loads by panel and classification (table)" IsChecked="True"
                          ToolTip="Sheet 'Fixture Loads by Class': the exported load elements (fixtures and the other ticked categories) added up - one row per panel, one column per load classification of the project, with totals."/>
                <CheckBox x:Name="IncludePanelRevit" Content="Panel loads by classification (Revit panel totals)" IsChecked="True"
                          ToolTip="Sheet 'Panel Loads by Class': Revit's own value of each ticked panel per load classification, plus Total Connected and Total Demand - the same numbers as an Electrical Equipment schedule. Includes everything fed through the panel."/>
                <CheckBox x:Name="IncludeSummary" Content="Summary + classification totals" IsChecked="True"/>
                <CheckBox x:Name="IncludePanelCheck" Content="Panel check vs Revit totals" IsChecked="True"/>
                <CheckBox x:Name="IncludeDiagnostics" Content="Diagnostics" IsChecked="True"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                         Text="Revit calculates demand per panel, not per load. Where a load has no demand value, its connected load is used and flagged in Diagnostics."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="5 · Output" Style="{StaticResource H}"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="OutputPath"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"/>
              </Grid>
              <CheckBox x:Name="OpenWhenDone" Content="Open the workbook when finished" IsChecked="True" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DetailText" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
          <ProgressBar x:Name="Progress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0"
                       Foreground="#0F766E" Background="#E2E8F0" BorderThickness="0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ExportButton" Content="Export to Excel" Style="{StaticResource Primary}" Margin="0,0,8,0" IsDefault="True"/>
          <Button x:Name="CloseButton" Content="Close" IsCancel="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
