<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Host Parameters"
        Height="660" Width="780" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SizeToContent="Manual">

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
               Text="Copy Mechanical Equipment Host Parameters"/>

    <StackPanel Grid.Row="1" Margin="0,8,0,14">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Scope:"/>
        <RadioButton x:Name="scope_model" GroupName="scope" Content="Entire model" IsChecked="True"
                     Checked="scope_changed" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <RadioButton x:Name="scope_view" GroupName="scope" Content="Active view"
                     Checked="scope_changed" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <RadioButton x:Name="scope_selection" GroupName="scope" Content="Current selection"
                     Checked="scope_changed" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Button x:Name="refresh" Click="refresh_click" Width="90" Content="Refresh"/>
      </StackPanel>

      <TextBlock TextWrapping="Wrap">
        <Run Text="Eligible fixtures: "/><Run x:Name="fixture_count" FontWeight="Bold" Text="0"/><Run Text=". Local and linked Mechanical Equipment hosts are included. This window stays open, so you can select elements in the model (for example with a crossing window) and then click Refresh."/>
      </TextBlock>

      <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Filter by fixture type:"/>
        <ComboBox x:Name="fixture_filter" Width="360"/>
        <Button x:Name="apply_filter" Click="apply_filter_click" Margin="8,0,0,0" Width="85" Content="Apply"/>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="SemiBold" Text="Host parameter"/>
      <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="SemiBold" Text="Fixture parameter"/>

      <ComboBox x:Name="source_combo" Grid.Row="1" Grid.Column="0" Margin="0,6,0,12"/>
      <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#x2192;"/>
      <ComboBox x:Name="destination_combo" Grid.Row="1" Grid.Column="2" Margin="0,6,0,12"/>

      <Grid Grid.Row="2" Grid.ColumnSpan="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
          <Button x:Name="preview" Click="preview_click" Width="115" Margin="0,0,8,0" Content="Preview values"/>
          <Button x:Name="add_mapping" Click="add_mapping_click" Width="115" Content="Add mapping"/>
          <CheckBox x:Name="coerce_check" Click="coerce_changed" IsChecked="True"
                    VerticalAlignment="Center" Margin="16,0,0,0"
                    Content="Write as text when the fixture parameter is a text parameter"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="0,10,0,3" FontWeight="SemiBold"
                   Text="Preview (Fixture ID | host value | current fixture value | result)"/>
        <ListBox Grid.Row="2" x:Name="preview_list" MinHeight="110"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="3" Margin="0,10,0,3" FontWeight="SemiBold" Text="Mappings to copy"/>
        <ListBox Grid.Row="4" x:Name="mapping_list" MinHeight="90" Margin="0,0,0,8"/>
        <Button Grid.Row="5" x:Name="remove_mapping" Click="remove_mapping_click" Width="130"
                HorizontalAlignment="Left" Content="Remove selected"/>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" x:Name="status" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.8" Text=""/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Click="cancel_click" Width="85" Margin="0,0,8,0" Content="Close"/>
      <Button x:Name="copy_button" Click="copy_click" Width="115" Content="Copy values"/>
    </StackPanel>
  </Grid>
</Window>
