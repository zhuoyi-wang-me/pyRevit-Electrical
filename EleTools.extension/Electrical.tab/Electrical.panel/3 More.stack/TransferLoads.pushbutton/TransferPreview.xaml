<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Review Before Transfer -- Old vs New"
    Width="1250"
    Height="760"
    MinWidth="800"
    MinHeight="480"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    FontFamily="Segoe UI"
    FontSize="12"
    Background="#F4F6F8">

    <Window.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="NumCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="4,0,8,0" />
        </Style>
        <Style x:Key="NewCell" TargetType="TextBlock" BasedOn="{StaticResource NumCell}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="WrapCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E8EEF5" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#C9D1DA" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Summary -->
        <Border Grid.Row="0" Background="White" BorderBrush="#C6D9E8" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Name="txtSummary" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                <TextBlock Name="txtSubSummary" Foreground="#444444" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search:" VerticalAlignment="Center" />
            <TextBox Name="txtSearch" Grid.Column="1" Height="24" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            <CheckBox Name="chkChangesOnly" Grid.Column="2" Content="Only rows that change something"
                      VerticalAlignment="Center" Margin="16,0,0,0" />
            <CheckBox Name="chkProblemsOnly" Grid.Column="3" Content="Only blocked rows"
                      VerticalAlignment="Center" Margin="16,0,0,0" />
            <Button Name="btnExport" Grid.Column="5" Content="Export CSV..." Width="110" Height="26" />
        </Grid>

        <!-- Before/after table -->
        <DataGrid Name="dgReport"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E3E8EE"
                  BorderBrush="#C9D1DA"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F7F9FB"
                  ColumnHeaderHeight="30"
                  MinRowHeight="26"
                  RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RowKind}" Value="write">
                            <Setter Property="Background" Value="#EAF6EC" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowKind}" Value="blocked">
                            <Setter Property="Background" Value="#FDECEC" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowKind}" Value="unchanged">
                            <Setter Property="Foreground" Value="#8A8A8A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RowKind}" Value="warning">
                            <Setter Property="Background" Value="#FFF3D6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Match Value" Binding="{Binding MatchValue}" Width="110" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Detail Item (target)" Binding="{Binding TargetName}" Width="*" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Source" Binding="{Binding SourceName}" Width="*" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Parameter" Binding="{Binding ParamPair}" Width="200" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="OLD value" Binding="{Binding OldValue}" Width="95" ElementStyle="{StaticResource NumCell}" />
                <DataGridTextColumn Header="NEW value" Binding="{Binding NewValue}" Width="95" ElementStyle="{StaticResource NewCell}" />
                <DataGridTextColumn Header="Change" Binding="{Binding ChangeText}" Width="130" ElementStyle="{StaticResource Cell}" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.3*" ElementStyle="{StaticResource WrapCell}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Legend -->
        <WrapPanel Grid.Row="3" Margin="0,6,0,0">
            <Border Background="#EAF6EC" BorderBrush="#C9D1DA" BorderThickness="1" Width="14" Height="14" Margin="0,0,4,0" />
            <TextBlock Text="Will write" Foreground="#6B7280" Margin="0,0,14,0" />
            <Border Background="#FFF3D6" BorderBrush="#C9D1DA" BorderThickness="1" Width="14" Height="14" Margin="0,0,4,0" />
            <TextBlock Text="Will write, with a warning" Foreground="#6B7280" Margin="0,0,14,0" />
            <Border Background="#FDECEC" BorderBrush="#C9D1DA" BorderThickness="1" Width="14" Height="14" Margin="0,0,4,0" />
            <TextBlock Text="Blocked - skipped" Foreground="#6B7280" Margin="0,0,14,0" />
            <TextBlock Text="Grey text = already correct, nothing changes" Foreground="#6B7280" />
        </WrapPanel>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Name="txtFooter" Grid.Column="0" Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Nothing has been written yet. Close or Cancel leaves the model untouched." />
            <Button Name="btnCancel" Grid.Column="1" Content="Cancel" Width="120" Height="36" Margin="10,0,0,0" />
            <Button Name="btnConfirm" Grid.Column="2" Content="CONFIRM TRANSFER" FontWeight="Bold" Width="200" Height="36"
                    Margin="10,0,0,0" Background="#2E7D32" Foreground="White" />
        </Grid>
    </Grid>
</Window>
