<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cross Check MEP" Height="920" Width="1320"
        MinHeight="700" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#F2F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#1C1C1E"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- iOS-style look: grey grouped background, white rounded cards, a
         segmented control for the three setup pages, switches, filled blue
         primary buttons and tinted secondary ones. Colours are the iOS
         system colours. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#007AFF"/>
        <SolidColorBrush x:Key="Green" Color="#34C759"/>
        <SolidColorBrush x:Key="Red" Color="#FF3B30"/>
        <SolidColorBrush x:Key="Label" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="Secondary" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Separator" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="Fill" Color="#EFEFF4"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <!-- small grey capitals above a group, like an iOS section header -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ===== buttons: tinted (default), filled, green, destructive ===== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E8F1FF"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="BigBlueButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="22,0"/>
        </Style>
        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Green}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="GrayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EFEFF4"/>
        </Style>
        <Style x:Key="RedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFE9E8"/>
            <Setter Property="Foreground" Value="{StaticResource Red}"/>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GrayButton}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

        <!-- ===== round tick (lists) and switch (options) ===== -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="dot" Width="18" Height="18" CornerRadius="9" Background="White"
                                    BorderBrush="#C7C7CC" BorderThickness="1.5" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,7.6 L 6.2,10.8 L 11.8,4.4" Stroke="White"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Background" Value="{StaticResource Blue}"/>
                                <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource Blue}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="track" DockPanel.Dock="Left" Width="42" Height="24" CornerRadius="12"
                                    Background="#E9E9EA" VerticalAlignment="Center">
                                <Ellipse x:Name="thumb" Width="20" Height="20" Fill="White" Margin="2,0"
                                         HorizontalAlignment="Left">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.28"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Green}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== text fields ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Fill}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="#8E8E93" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="5,0,8,0" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== lists ===== -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Separator}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="2">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E3EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== pickers ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="9,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#EFEFF4" CornerRadius="9">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                                                  Data="M 0,0 L 4,4 L 8,0" Stroke="#8E8E93" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Margin="10,4,10,12" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="White"
                                        CornerRadius="12" BorderBrush="#E5E5EA" BorderThickness="1" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.2"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== segmented control (the three setup pages) ===== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#E3E3E8" CornerRadius="10" Padding="2"
                                    HorizontalAlignment="Left" Margin="0,0,0,10">
                                <StackPanel IsItemsHost="True" Orientation="Horizontal"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="26,6" MinWidth="150">
                            <ContentPresenter x:Name="cp" ContentSource="Header" HorizontalAlignment="Center"
                                              TextElement.Foreground="#3C3C43"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter TargetName="cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="#1C1C1E"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.16"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== results table ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EFEFF4"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="{StaticResource Separator}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EEFF"/>
                    <Setter Property="Foreground" Value="#1C1C1E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="CellGrey" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="#6C6C70"/>
        </Style>

        <!-- one tick row of the family / level / category lists -->
        <DataTemplate x:Key="TickRow">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{Binding Label}">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= large title + saved templates ================= -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Border DockPanel.Dock="Right" Style="{StaticResource Card}" Padding="12,8" VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Template" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <ComboBox x:Name="cmbTemplates" Width="230" Margin="0,0,8,0"/>
                    <Button x:Name="btnLoadTemplate" Content="Load" Style="{StaticResource BlueButton}" Click="load_template"/>
                    <Button x:Name="btnSaveTemplate" Content="Save As..." Click="save_template"/>
                    <Button x:Name="btnImportLast" Content="Last Used" Style="{StaticResource GrayButton}" Click="import_last_template"
                            ToolTip="Restores the setup of the last cross check that was run."/>
                    <Button x:Name="btnDeleteTemplate" Content="Delete" Style="{StaticResource RedButton}" Margin="0" Click="delete_template"/>
                </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="Cross Check" FontSize="30" FontWeight="Bold" Foreground="Black"/>
                <TextBlock Text="Model elements against Detail Items, in both directions" Foreground="{StaticResource Secondary}"
                           FontSize="13" Margin="1,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ================= setup: Collect | Filters | Fields ================= -->
        <TabControl x:Name="setupTabs" Grid.Row="1" Margin="0,0,0,12">

            <!-- 1 Collect -->
            <TabItem Header="1   Collect">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2.4*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="MEP CATEGORIES" Style="{StaticResource Section}"/>
                            <TextBox x:Name="txtSearchCategories" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                                     ToolTip="Search by category or discipline"/>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button x:Name="btnCategoriesAll" Content="All" Style="{StaticResource MiniButton}"/>
                                <Button x:Name="btnCategoriesNone" Content="None" Style="{StaticResource MiniButton}"/>
                                <Button x:Name="btnCatElectrical" Content="+ Electrical" Style="{StaticResource MiniButton}" Background="#E8F1FF"/>
                                <Button x:Name="btnCatMechanical" Content="+ Mechanical" Style="{StaticResource MiniButton}" Background="#E8F1FF"/>
                                <Button x:Name="btnCatPlumbing" Content="+ Plumbing" Style="{StaticResource MiniButton}" Background="#E8F1FF" Margin="0"/>
                            </WrapPanel>
                            <ListBox x:Name="lstCategories" Height="150" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Group}" Foreground="#AEAEB2"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                                <TextBlock Text="{Binding Label}"/>
                                            </CheckBox>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="WHERE TO LOOK" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="cmbScope" DockPanel.Dock="Top" SelectedIndex="1"
                                      ToolTip="The third choice is for single line diagrams: every panel in the model, but only the Detail Items of the view that is open."/>
                            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Separator}" Margin="0,12"/>
                            <CheckBox x:Name="chkExcludeNested" DockPanel.Dock="Top" Style="{StaticResource Switch}" IsChecked="True"
                                      ToolTip="Skip shared families nested inside another family (e.g. breakers inside a panel, VAV sub-parts) so they don't appear as extra elements.">
                                <TextBlock Text="Skip nested shared components" TextWrapping="Wrap"/>
                            </CheckBox>
                            <Button x:Name="btnCollect" DockPanel.Dock="Bottom" Content="Collect Elements"
                                    Style="{StaticResource BigBlueButton}" Margin="0" Click="collect_elements"/>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="2,0,0,10"
                                       Text="Collect first. The lists on the right and the field pickers on the other pages are filled from what is found."/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="MEP FAMILIES  ·  NONE TICKED = ALL" Style="{StaticResource Section}"/>
                                <TextBox x:Name="txtSearchElecFamilies" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnElecFamiliesAll" Content="All" Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btnElecFamiliesNone" Content="None" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <ListBox x:Name="lstElecFamilies" Height="150" HorizontalContentAlignment="Stretch"
                                         ItemTemplate="{StaticResource TickRow}"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2">
                                <TextBlock DockPanel.Dock="Top" Text="DETAIL ITEM FAMILIES" Style="{StaticResource Section}"/>
                                <TextBox x:Name="txtSearchDetailFamilies" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnDetailFamiliesAll" Content="All" Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btnDetailFamiliesNone" Content="None" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <ListBox x:Name="lstDetailFamilies" Height="150" HorizontalContentAlignment="Stretch"
                                         ItemTemplate="{StaticResource TickRow}"/>
                            </DockPanel>
                            <DockPanel Grid.Column="4">
                                <TextBlock DockPanel.Dock="Top" Text="LEVELS" Style="{StaticResource Section}"/>
                                <TextBox x:Name="txtSearchLevels" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Margin="0,0,0,6"/>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="btnLevelsAll" Content="All" Style="{StaticResource MiniButton}"/>
                                    <Button x:Name="btnLevelsNone" Content="None" Style="{StaticResource MiniButton}"/>
                                </StackPanel>
                                <ListBox x:Name="lstLevels" Height="150" HorizontalContentAlignment="Stretch"
                                         ItemTemplate="{StaticResource TickRow}"
                                         ToolTip="Detail Items in a drafting view have no level and are never filtered out."/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2 Filters -->
            <TabItem Header="2   Filters">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="MEP ELEMENTS  ·  ALL ROWS MUST BE TRUE" Style="{StaticResource Section}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="cmbElecFilterParam1" Grid.Row="0" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbElecFilterCond1" Grid.Row="0" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtElecFilterValue1" Grid.Row="0" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbElecFilterParam2" Grid.Row="1" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbElecFilterCond2" Grid.Row="1" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtElecFilterValue2" Grid.Row="1" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbElecFilterParam3" Grid.Row="2" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbElecFilterCond3" Grid.Row="2" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtElecFilterValue3" Grid.Row="2" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbElecFilterParam4" Grid.Row="3" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbElecFilterCond4" Grid.Row="3" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtElecFilterValue4" Grid.Row="3" Grid.Column="2" Margin="0,3,0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="DETAIL ITEMS  ·  ALL ROWS MUST BE TRUE" Style="{StaticResource Section}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="cmbDetailFilterParam1" Grid.Row="0" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbDetailFilterCond1" Grid.Row="0" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtDetailFilterValue1" Grid.Row="0" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbDetailFilterParam2" Grid.Row="1" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbDetailFilterCond2" Grid.Row="1" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtDetailFilterValue2" Grid.Row="1" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbDetailFilterParam3" Grid.Row="2" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbDetailFilterCond3" Grid.Row="2" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtDetailFilterValue3" Grid.Row="2" Grid.Column="2" Margin="0,3,0,3"/>
                                <ComboBox x:Name="cmbDetailFilterParam4" Grid.Row="3" Grid.Column="0" Margin="0,3,6,3" DisplayMemberPath="label"/>
                                <ComboBox x:Name="cmbDetailFilterCond4" Grid.Row="3" Grid.Column="1" Margin="0,3,6,3"/>
                                <TextBox x:Name="txtDetailFilterValue4" Grid.Row="3" Grid.Column="2" Margin="0,3,0,3"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="4,8,0,0"
                               Text="Optional. Works like a schedule filter: pick a parameter, a condition and a value. A row left on (none) is ignored."/>
                </Grid>
            </TabItem>

            <!-- 3 Fields and Run -->
            <TabItem Header="3   Fields &amp; Run">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.25*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PAIRING KEY  ·  WHICH DETAIL ITEM BELONGS TO WHICH ELEMENT" Style="{StaticResource Section}"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="btnRemoveKey" DockPanel.Dock="Right" Content="Remove" Style="{StaticResource RedButton}" Margin="0" Click="remove_key_pair"/>
                                <Button x:Name="btnAddKey" DockPanel.Dock="Right" Content="Add" Style="{StaticResource BlueButton}" Click="add_key_pair"/>
                                <Grid Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbKeyElec" Grid.Column="0" DisplayMemberPath="label" ToolTip="MEP element field"/>
                                    <TextBlock Grid.Column="1" Text="=" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Secondary}"/>
                                    <ComboBox x:Name="cmbKeyDetail" Grid.Column="2" DisplayMemberPath="label" ToolTip="Detail Item field"/>
                                </Grid>
                            </DockPanel>
                            <ListBox x:Name="lstKeyPairs" Height="84"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="COMPARISON  ·  EACH LINE IS CHECKED AND REPORTED ON ITS OWN" Style="{StaticResource Section}"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="btnRemoveValue" DockPanel.Dock="Right" Content="Remove" Style="{StaticResource RedButton}" Margin="0" Click="remove_value_pair"/>
                                <Button x:Name="btnAddValue" DockPanel.Dock="Right" Content="Add" Style="{StaticResource BlueButton}" Click="add_value_pair"/>
                                <Grid Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="cmbValElec" Grid.Column="0" DisplayMemberPath="label" ToolTip="MEP element field"/>
                                    <ComboBox x:Name="cmbValCondition" Grid.Column="1" Margin="6,0"/>
                                    <ComboBox x:Name="cmbValDetail" Grid.Column="2" DisplayMemberPath="label" ToolTip="Detail Item field"/>
                                </Grid>
                            </DockPanel>
                            <ListBox x:Name="lstValuePairs" Height="84"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="16,10" Margin="0,12,0,0">
                        <DockPanel>
                            <Button x:Name="btnRunCheck" DockPanel.Dock="Right" Content="Run Cross Check"
                                    Style="{StaticResource BigBlueButton}" Margin="0" Click="run_cross_check"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="chkCaseSensitive" Style="{StaticResource Switch}" Margin="0,0,28,0">
                                    <TextBlock Text="Case sensitive"/>
                                </CheckBox>
                                <CheckBox x:Name="chkCompareAll" Style="{StaticResource Switch}"
                                          ToolTip="Off: an element whose key is found on several Detail Items is reported as AMBIGUOUS and not compared. On: it is compared with each of them, one row per Detail Item.">
                                    <TextBlock Text="Compare with every Detail Item that has the same key (instead of AMBIGUOUS)"/>
                                </CheckBox>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= results ================= -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                    <TextBox x:Name="txtResultSearch" DockPanel.Dock="Right" Width="240" Style="{StaticResource SearchBox}"
                             TextChanged="result_search_changed"
                             ToolTip="Searches every column. Several words = all must be in the row."/>
                    <TextBlock DockPanel.Dock="Left" Text="Results" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="2,0,16,0"/>
                    <WrapPanel x:Name="pnlChips" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Height="1" DockPanel.Dock="Top" Background="{StaticResource Separator}"/>
                <DataGrid x:Name="dgResults" AutoGenerateColumns="False" IsReadOnly="True" Margin="4,0,4,6"
                          SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          MouseDoubleClick="result_double_click">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUS" Width="158" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="pill" CornerRadius="10" Padding="9,2" Margin="8,0" Background="#EFEFF4"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock x:Name="pillText" Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#3C3C43"/>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="MATCH">
                                            <Setter TargetName="pill" Property="Background" Value="#DDF6E3"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#1B7A34"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="PARTIAL MATCH">
                                            <Setter TargetName="pill" Property="Background" Value="#DCEBFF"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#0058C7"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NOT MATCH">
                                            <Setter TargetName="pill" Property="Background" Value="#FFE1DF"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#C4231A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="NO MATCH">
                                            <Setter TargetName="pill" Property="Background" Value="#FFEFD6"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#A85F00"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="AMBIGUOUS">
                                            <Setter TargetName="pill" Property="Background" Value="#F1E3FA"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#7E2FA8"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="ORPHAN DETAIL ITEM">
                                            <Setter TargetName="pill" Property="Background" Value="#D9F2F7"/>
                                            <Setter TargetName="pillText" Property="Foreground" Value="#17758A"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120" ElementStyle="{StaticResource CellGrey}"/>
                        <DataGridTextColumn Header="MEP ELEMENT" Binding="{Binding MepElement}" Width="150" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="LEVEL" Binding="{Binding MepLevel}" Width="80" ElementStyle="{StaticResource CellGrey}"/>
                        <DataGridTextColumn Header="DETAIL ITEM" Binding="{Binding Detail}" Width="150" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="DETAIL LEVEL" Binding="{Binding DetailLevel}" Width="92" ElementStyle="{StaticResource CellGrey}"/>
                        <DataGridTextColumn Header="MATCH KEY" Binding="{Binding MatchKey}" Width="150" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="FIELD COMPARISON" Binding="{Binding FieldComparison}" Width="2*" ElementStyle="{StaticResource Cell}"/>
                        <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="*" ElementStyle="{StaticResource CellGrey}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ================= toolbar ================= -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button x:Name="btnSelectModel" Content="Select in Model" Style="{StaticResource BlueButton}" Click="select_in_model"/>
                <Button x:Name="btnZoomTo" Content="Zoom To" Click="zoom_to" ToolTip="Or double-click a row."/>
                <Button x:Name="btnIsolate" Content="Isolate in View" Click="isolate_in_view"/>
                <Button x:Name="btnClearIsolate" Content="Clear Isolate" Style="{StaticResource GrayButton}" Click="clear_isolate"/>
                <Button x:Name="btnExportCsv" Content="Export CSV" Style="{StaticResource GreenButton}" Click="export_results_csv"
                        ToolTip="Exports the rows that are shown (status filter and search apply)."/>
                <Button x:Name="btnClearResults" Content="Clear Results" Style="{StaticResource RedButton}" Click="clear_results"/>
            </StackPanel>
            <TextBlock x:Name="txtStatus" Text="Ready." VerticalAlignment="Center" HorizontalAlignment="Right"
                       Foreground="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="12,0,2,0"/>
        </DockPanel>
    </Grid>
</Window>
