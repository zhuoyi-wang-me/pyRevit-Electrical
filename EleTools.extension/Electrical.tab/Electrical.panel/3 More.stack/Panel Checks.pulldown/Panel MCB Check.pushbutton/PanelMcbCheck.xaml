<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Panel MCB Check"
    Width="1340"
    Height="800"
    MinWidth="1040"
    MinHeight="620"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Background="#FFF2F4F7"
    Foreground="#FF1D2733"
    FontFamily="Segoe UI"
    FontSize="12.5"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display">
    <!--
        Modal window for script.py (PanelMcbWindow).  Every Name= below is
        used from Python - keep the names when restyling.  The styles are
        the same set as Export Manager, so the two tools look alike.
        Icons are "Segoe MDL2 Assets" glyphs (ships with Windows 10/11).
    -->

    <Window.Resources>
        <!-- ============================ Palette ============================ -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0B6BCB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF0958A8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF074785" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFE8F1FC" />
        <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#FFBBD6F5" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1D2733" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF667585" />
        <SolidColorBrush x:Key="LineBrush" Color="#FFDCE2E9" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#FFB9C3CE" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FFF6F8FA" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FFEEF2F6" />
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE6EAEF" />
        <SolidColorBrush x:Key="GoBrush" Color="#FF16845B" />
        <SolidColorBrush x:Key="GoHoverBrush" Color="#FF116D4A" />
        <SolidColorBrush x:Key="GoPressedBrush" Color="#FF0C573B" />

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0F2A47" Offset="0" />
            <GradientStop Color="#FF1A4D7C" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ============================ Text ============================== -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- ============================ Cards ============================= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="InfoBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TrackBrush}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <!-- Rounded shell for a text box that carries an icon / clear button -->
        <Style x:Key="InputShell" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ Buttons =========================== -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter x:Name="label"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="icon" Property="Margin" Value="0" />
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TrackBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

        <!-- Filled blue: the main action of a panel -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filled green: EXPORT -->
        <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource GoBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="15"
                                           Margin="0,1,10,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource GoPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF8A97A5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Translucent button for the dark header band -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,8,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless square icon button (clear search etc.) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- ============================ Text boxes ======================== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter TargetName="bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text box with no chrome: lives inside an InputShell border -->
        <Style x:Key="BareTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="Transparent"
                                      VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Check / radio ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box"
                                    Width="17"
                                    Height="17"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="#FF94A1AE"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Path x:Name="tick"
                                          Data="M2.5,7 L5.8,10.2 L11.5,3.8"
                                          Stroke="White"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                    <Rectangle x:Name="dash"
                                               Width="8"
                                               Height="2"
                                               Fill="White"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="content"
                                              Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter TargetName="content" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="17" Height="17" VerticalAlignment="Center">
                                <Ellipse x:Name="ring"
                                         Fill="White"
                                         Stroke="#FF94A1AE"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="dot"
                                         Width="7"
                                         Height="7"
                                         Fill="{StaticResource AccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio button drawn as one segment of a segmented switch -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="icon"
                                           Style="{StaticResource Glyph}"
                                           FontSize="13"
                                           Margin="0,1,7,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Combo box ========================= -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,1,11,0"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Stroke="#FF667585"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF667585" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF0B6BCB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0"
                                        Background="White"
                                        BorderBrush="{StaticResource LineStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer Margin="0,3">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ List box ========================== -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                CornerRadius="4"
                                Margin="3,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer Margin="0,2" Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBrush}" />
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Data grid ========================= -->
        <Style x:Key="ColumnGripper" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Path x:Name="sort"
                                          Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Data="M0,4 L4,0 L8,4"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1.6"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource ColumnGripper}" />
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource ColumnGripper}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="sort" Property="Visibility" Value="Visible" />
                                <Setter TargetName="sort" Property="Data" Value="M0,0 L4,4 L8,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FFFAFBFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEDF0F3" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="RowHeight" Value="30" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="CanUserResizeRows" Value="False" />
        </Style>

        <!-- ============================ Cards as GroupBox / Expander ====== -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border x:Name="bd"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12,14,14">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"
                                                  ContentSource="Header"
                                                  Margin="0,0,0,8"
                                                  TextElement.FontSize="13.5"
                                                  TextElement.FontWeight="SemiBold" />
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10,14,14">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              Focusable="False"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Background="Transparent" Height="24">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.FontSize="13.5"
                                                                  TextElement.FontWeight="SemiBold" />
                                                <Path x:Name="chevron"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,2,0"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="#FF667585"
                                                      StrokeThickness="1.6" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chevron" Property="Data" Value="M0,4 L4,0 L8,4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Wizard steps ====================== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent" Height="50" Margin="0,0,26,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="badge"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{StaticResource TrackBrush}">
                                    <TextBlock x:Name="badgeText"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="9,0,0,0"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                            <Border x:Name="line"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="1.5"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="badge" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="badgeText" Property="Foreground" Value="White" />
                                <Setter TargetName="line" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="White"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal"
                                            IsItemsHost="True"
                                            Margin="20,0" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="20,12">
            <DockPanel>
                <Border Width="38"
                        Height="38"
                        CornerRadius="9"
                        Background="#26FFFFFF"
                        VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Glyph}"
                               Text="&#xE945;"
                               FontSize="19"
                               Foreground="White"
                               HorizontalAlignment="Center" />
                </Border>
                <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Panel MCB Check"
                               Foreground="White"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Name="txtDocName"
                               Text="Panel incomer rating against connected circuit ratings"
                               Foreground="#FFC3D5E8"
                               FontSize="12"
                               Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ====================== Left: filters ======================= -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,10,0"
                          Padding="0,0,4,0">
                <StackPanel>
                    <GroupBox Header="Filter panels">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SEARCH" Margin="0,2,0,4" />
                            <Border Style="{StaticResource InputShell}"
                                    ToolTip="Searches panel name, number, level and type. Every word must match.">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               Style="{StaticResource Glyph}"
                                               Text="&#xE721;"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="10,0,8,0" />
                                    <Button Name="btnClearSearch"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource IconButton}"
                                            Tag="&#xE711;"
                                            Margin="0,0,2,0"
                                            ToolTip="Clear search" />
                                    <Grid>
                                        <TextBox Name="txtSearch" Style="{StaticResource BareTextBox}" />
                                        <TextBlock Text="Name, number, level, type..."
                                                   Foreground="#FF98A4B0"
                                                   Margin="3,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="LEVEL" />
                            <ComboBox Name="cmbLevel" />

                            <!-- Multi-select: tick one or more types; none ticked = all types -->
                            <DockPanel Margin="0,10,0,4">
                                <Button Name="btnTypesNone"
                                        DockPanel.Dock="Right"
                                        Content="None"
                                        Height="22"
                                        Padding="8,0"
                                        FontSize="11.5"
                                        Margin="4,0,0,0"
                                        ToolTip="Untick every panel type (shows all types again)" />
                                <Button Name="btnTypesAll"
                                        DockPanel.Dock="Right"
                                        Content="All"
                                        Height="22"
                                        Padding="8,0"
                                        FontSize="11.5"
                                        ToolTip="Tick every panel type" />
                                <TextBlock Name="txtTypeLabel"
                                           Style="{StaticResource FieldLabel}"
                                           Text="PANEL TYPE"
                                           Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Name="lstTypes"
                                     Height="150"
                                     ToolTip="Tick the panel types (family : type) to list. With nothing ticked, every type is listed.">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding Name, Mode=OneWay}">
                                            <TextBlock Text="{Binding Label, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Name="btnTickTypes"
                                    Tag="&#xE73E;"
                                    Content="Tick panels of ticked types"
                                    Margin="0,6,0,0"
                                    ToolTip="Tick every panel whose type is ticked above (other filters are ignored)" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="STATUS" />
                            <ComboBox Name="cmbStatus" />

                            <CheckBox Name="chkWithCircuits"
                                      Content="Only panels that feed circuits"
                                      Margin="0,14,0,0" />
                            <CheckBox Name="chkOnlyTicked"
                                      Content="Only ticked panels"
                                      Margin="0,8,0,0" />

                            <Button Name="btnResetFilters"
                                    Tag="&#xE72C;"
                                    Content="Reset filters"
                                    Margin="0,14,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Standard ratings" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBox Name="txtRatings" Text="32, 40, 63, 80, 100, 125" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,7,0,0"
                                       Text="Amperes, separated by commas. The suggested MCB Rating is the first of these that is above the highest circuit Rating on the panel." />
                        </StackPanel>
                    </GroupBox>

                    <Border Style="{StaticResource InfoBox}" Margin="0,10,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{StaticResource AccentPressedBrush}"
                                   Text="The MCB Rating must be more than every circuit Rating. A panel is flagged when any circuit Rating is equal to or greater than its MCB Rating. Circuits with no valid Rating are ignored." />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ====================== Right: panels ======================= -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <!-- Tick tools -->
                    <DockPanel Grid.Row="0" Margin="14,11,14,11">
                        <Border DockPanel.Dock="Right"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="12"
                                Padding="12,4"
                                VerticalAlignment="Center">
                            <TextBlock Name="txtTicked"
                                       Text="Ticked : 0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPressedBrush}" />
                        </Border>
                        <TextBlock Name="txtShown"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0" />
                        <CheckBox Name="chkTickAll"
                                  Content="Tick all shown"
                                  VerticalAlignment="Center"
                                  ToolTip="Ticks / unticks only the panels currently shown" />
                        <Button Name="btnClearTicks"
                                Tag="&#xE894;"
                                Content="Clear all ticks"
                                Margin="16,0,0,0"
                                ToolTip="Untick every panel, including panels hidden by the filters" />
                        <Button Name="btnTickSelection"
                                Tag="&#xE8B3;"
                                Content="Tick Revit selection"
                                Margin="8,0,10,0"
                                HorizontalAlignment="Left"
                                ToolTip="Tick the panels that were selected in Revit when the tool was started" />
                    </DockPanel>

                    <!-- Panels -->
                    <DataGrid Name="dgPanels"
                              Grid.Row="1"
                              BorderThickness="0,1,0,1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              EnableRowVirtualization="True"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Panel Name" Binding="{Binding Name}" IsReadOnly="True" Width="1.3*" MinWidth="100" />
                            <DataGridTextColumn Header="Panel No." Binding="{Binding Number}" IsReadOnly="True" Width="82" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" IsReadOnly="True" Width="84" />
                            <DataGridTextColumn Header="Panel Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="1.5*" MinWidth="100" />
                            <DataGridTextColumn Header="Circuits" Binding="{Binding CircuitCount}" IsReadOnly="True" Width="68" />
                            <DataGridTextColumn Header="MCB Rating" Binding="{Binding McbText}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Highest Circuit" Binding="{Binding HighestText}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Suggested" Binding="{Binding SuggestedText}" IsReadOnly="True" Width="90" />
                            <DataGridTemplateColumn Header="Status" Width="205" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBack}"
                                                CornerRadius="10"
                                                Padding="9,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusColor}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11.5" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Circuits of the highlighted panel -->
                    <DockPanel Grid.Row="2" Margin="14,10,14,8">
                        <TextBlock Name="txtDetailTitle"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource CardTitle}"
                                   Text="Circuits" />
                        <TextBlock Name="txtDetailHint"
                                   Style="{StaticResource Hint}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </DockPanel>
                    <DataGrid Name="dgCircuits"
                              Grid.Row="3"
                              BorderThickness="0,1,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              RowHeight="27">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Circuit Number" Binding="{Binding Number}" Width="130" />
                            <DataGridTextColumn Header="Load Name" Binding="{Binding LoadName}" Width="*" />
                            <DataGridTextColumn Header="Rating" Binding="{Binding RatingText}" Width="110" />
                            <DataGridTemplateColumn Header="Result" Width="190" SortMemberPath="Verdict">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Verdict}"
                                                   Foreground="{Binding VerdictColor}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================ Footer ============================ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Name="btnClose"
                            Content="Close"
                            Width="84"
                            Height="38" />
                    <Button Name="btnReport"
                            Tag="&#xE8A5;"
                            Content="Report and close"
                            Height="38"
                            Margin="8,0,0,0"
                            ToolTip="Close this window and print the results table in the pyRevit output window, with clickable links to each panel and circuit" />
                    <Button Name="btnUpdate"
                            Style="{StaticResource GoButton}"
                            Tag="&#xE70F;"
                            Content="Update MCB Rating"
                            Margin="18,0,0,0"
                            ToolTip="Write the suggested MCB Rating to the ticked panels that need it. Changes the model." />
                    <Button Name="btnCheck"
                            Style="{StaticResource PrimaryButton}"
                            Tag="&#xE73E;"
                            Content="Check ticked panels"
                            Height="38"
                            Padding="20,0"
                            FontSize="13.5"
                            Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Name="txtFooter"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
