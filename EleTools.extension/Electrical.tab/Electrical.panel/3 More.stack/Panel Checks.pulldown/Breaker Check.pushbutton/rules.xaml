<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaker Check" Width="760" Height="600" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F3F3F3" Foreground="#1B1B1B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- the styles (buttons, fields, table) are those of ui.xaml: bc_rules.py hands them to this window -->
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Load types" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
            <TextBlock Foreground="#5C5C5C" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="The minimum breaker rating the project requires for each type of load. A circuit whose load needs more than the minimum gets the next rating above its load. The text is looked for, as whole words, in the Load Classification and in the Load Name of a circuit; when two fit, the longer text is used."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>
            <!-- the rules: type in the last, empty row to add one -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <DataGrid x:Name="gridRules" AutoGenerateColumns="True" HeadersVisibility="Column" CanUserAddRows="True" CanUserDeleteRows="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0" ColumnWidth="*"
                          BorderThickness="0" Background="Transparent" RowBackground="White" Margin="1,1,1,6"/>
            </Border>
            <!-- what the chosen panels contain, to pick from -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Load classifications in the chosen panels" Foreground="#5C5C5C" FontSize="12" Margin="2,0,0,6" TextWrapping="Wrap"/>
                <Border Grid.Row="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="8" Padding="0,4">
                    <ListBox x:Name="lstFound" BorderThickness="0" Background="Transparent" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
                <Button x:Name="btnAdd" Grid.Row="2" Content="Add to the list" Margin="0,8,0,0" HorizontalAlignment="Left"/>
            </Grid>
        </Grid>

        <TextBlock x:Name="lblProblem" Grid.Row="2" Foreground="#C42B1C" TextWrapping="Wrap" Margin="2,10,0,0"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button x:Name="btnDelete" Content="Delete row" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOk" Content="Use these" Style="{DynamicResource Accent}"/>
                <Button x:Name="btnCancel" Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
