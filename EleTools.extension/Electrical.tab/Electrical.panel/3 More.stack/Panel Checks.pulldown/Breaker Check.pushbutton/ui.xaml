<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Breaker Check" Width="1240" Height="760" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="#F3F3F3" Foreground="#1B1B1B" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ============ Windows 11 look: buttons ============ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F2F2F2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#E9E9E9"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Accent" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#005FB8" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A6FBF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#3380C6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#BDBDBD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ text field: rounded, accent line when in use ============ -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="White" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <Border x:Name="line" Height="1" VerticalAlignment="Bottom" Background="#8A8A8A" CornerRadius="0,0,4,4" Margin="1,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F9F9F9"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="line" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="line" Property="Height" Value="2"/>
                                <Setter TargetName="b" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ check box ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" BorderBrush="#8A8A8A" Background="White" VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="White" StrokeThickness="1.6" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#005FB8"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#005FB8"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ cards ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ============ table ============ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#5C5C5C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#EBEBEB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F6F6F6"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E6F0FA"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1B1B1B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the tick of a row: one click -->
        <DataTemplate x:Key="TickCell">
            <CheckBox IsChecked="{Binding [Update], UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
        </DataTemplate>
        <!-- the result as a coloured pill -->
        <DataTemplate x:Key="ResultCell">
            <Border x:Name="pill" CornerRadius="10" Padding="10,2" HorizontalAlignment="Left" Background="#FFF4CE">
                <TextBlock x:Name="word" Text="{Binding [Result]}" FontSize="11.5" FontWeight="SemiBold" Foreground="#9D5D00"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding [Result]}" Value="UNDERSIZED">
                    <Setter TargetName="pill" Property="Background" Value="#FDE7E9"/><Setter TargetName="word" Property="Foreground" Value="#C42B1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [Result]}" Value="OK">
                    <Setter TargetName="pill" Property="Background" Value="#DFF6DD"/><Setter TargetName="word" Property="Foreground" Value="#0F7B0F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [Result]}" Value="NO LOAD">
                    <Setter TargetName="pill" Property="Background" Value="#F0F0F0"/><Setter TargetName="word" Property="Foreground" Value="#5C5C5C"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- the new rating: always a field, so it is clear that it can be typed -->
        <DataTemplate x:Key="NewCell">
            <TextBox Text="{Binding [New breaker A], UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Field}" Height="26" Width="74"
                     HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- title and the panels in use -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Breaker Check" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                <TextBlock x:Name="lblPanels" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="btnRules" Content="Load types..."
                        ToolTip="The minimum breaker rating the project requires for each type of load, e.g. Lighting 16 A, AC 20 A."/>
                <Button x:Name="btnOpenTemplate" Content="Open template..." Margin="8,0,0,0"
                        ToolTip="Load types, ratings, power factor and margin from a saved template."/>
                <Button x:Name="btnSaveTemplate" Content="Save template..." Margin="8,0,0,0"/>
                <Button x:Name="btnPanels" Content="Change panels..." Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- the result at a glance -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
            <Border Style="{StaticResource Stat}">
                <StackPanel><TextBlock x:Name="numUndersized" Style="{StaticResource StatNumber}" Foreground="#C42B1C" Text="0"/><TextBlock Text="Undersized" Style="{StaticResource Caption}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel><TextBlock x:Name="numOversized" Style="{StaticResource StatNumber}" Foreground="#9D5D00" Text="0"/><TextBlock Text="Oversized" Style="{StaticResource Caption}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel><TextBlock x:Name="numNoRating" Style="{StaticResource StatNumber}" Foreground="#9D5D00" Text="0"/><TextBlock Text="No rating" Style="{StaticResource Caption}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel><TextBlock x:Name="numOk" Style="{StaticResource StatNumber}" Foreground="#0F7B0F" Text="0"/><TextBlock Text="OK" Style="{StaticResource Caption}"/></StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel><TextBlock x:Name="numOther" Style="{StaticResource StatNumber}" Foreground="#5C5C5C" Text="0"/><TextBlock Text="No load / other" Style="{StaticResource Caption}"/></StackPanel>
            </Border>
        </StackPanel>

        <!-- the rule and the ratings that may be proposed -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Power factor" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="txtPf" Grid.Column="1" Style="{StaticResource Field}" HorizontalContentAlignment="Center"
                         ToolTip="Current = load in W / (voltage x power factor). Three-phase: / (1.73 x voltage x power factor)."/>
                <TextBlock Grid.Column="2" Text="Breaker at least" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <TextBox x:Name="txtMargin" Grid.Column="3" Style="{StaticResource Field}" HorizontalContentAlignment="Center"
                         ToolTip="1.25 = the breaker must be at least 125 % of the current. 1 = at least the current."/>
                <TextBlock Grid.Column="4" Text="x current        Ratings (A)" VerticalAlignment="Center" Margin="8,0,8,0"/>
                <TextBox x:Name="txtRatings" Grid.Column="5" Style="{StaticResource Field}"
                         ToolTip="The breaker ratings available on your project, separated by commas. Filled the first time with the ratings already used in this model."/>
                <Button x:Name="btnRecheck" Grid.Column="6" Content="Check again" Margin="10,0,0,0"/>
                <CheckBox x:Name="chkProblems" Grid.Column="7" Content="Show only problems" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </Grid>
        </Border>

        <!-- the circuits -->
        <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid x:Name="grid" AutoGenerateColumns="True" HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                      BorderThickness="0" Background="Transparent" RowBackground="White" Margin="1,1,1,6"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </Border>

        <!-- what happened / what to do -->
        <Border x:Name="barMessages" Grid.Row="4" CornerRadius="6" Padding="14,8" Margin="0,12,0,0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1">
            <TextBox x:Name="txtMessages" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="84" VerticalScrollBarVisibility="Auto"
                     BorderThickness="0" Background="Transparent"/>
        </Border>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnTick" Content="Tick all that do not match"/>
                <Button x:Name="btnUntick" Content="Untick all" Margin="8,0,0,0"/>
                <Button x:Name="btnSelect" Content="Select in Revit" Margin="8,0,0,0"
                        ToolTip="Closes this window and selects the highlighted circuits in Revit."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnExport" Content="Export CSV..."/>
                <Button x:Name="btnUpdate" Content="Update ticked breakers..." Style="{StaticResource Accent}" Margin="8,0,0,0"/>
                <Button x:Name="btnClose" Content="Close" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
