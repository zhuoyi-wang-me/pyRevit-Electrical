<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MEP Level Fixer - Preview"
        Height="760" Width="1240" MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        Background="#FFF4F5F7">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2A3F5F" CornerRadius="3"
                Padding="14,10,14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="lbl_title" Text="Preview of proposed changes"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="lbl_subtitle" Foreground="#FFCBD5E1"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Filter bar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Category" VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
            <ComboBox Grid.Column="1" x:Name="cmb_category" Height="24"
                      SelectionChanged="on_filter_changed"/>

            <TextBlock Grid.Column="2" Text="Status" VerticalAlignment="Center"
                       Margin="12,0,6,0"/>
            <ComboBox Grid.Column="3" x:Name="cmb_status" Height="24"
                      SelectionChanged="on_filter_changed"/>

            <TextBlock Grid.Column="4" Text="Search" VerticalAlignment="Center"
                       Margin="12,0,6,0"/>
            <TextBox Grid.Column="5" x:Name="txt_search" Height="24"
                     TextChanged="on_filter_changed"
                     ToolTip="Filter by id, family, type or level name"/>

            <Button Grid.Column="6" Content="Clear" Width="60" Height="24"
                    Margin="6,0,0,0" Click="on_clear_filters"/>
        </Grid>

        <!-- Grid -->
        <DataGrid Grid.Row="2" x:Name="grid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF7F9FC"
                  RowHeaderWidth="0"
                  BorderBrush="#FFD0D4DA"
                  SelectionChanged="on_row_selection_changed"
                  MouseDoubleClick="on_row_double_click">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Apply" Width="55"
                                        Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Element ID" Width="95" IsReadOnly="True"
                                    Binding="{Binding ElementId}"/>
                <DataGridTextColumn Header="Category" Width="130" IsReadOnly="True"
                                    Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Family" Width="160" IsReadOnly="True"
                                    Binding="{Binding Family}"/>
                <DataGridTextColumn Header="Type" Width="160" IsReadOnly="True"
                                    Binding="{Binding TypeName}"/>
                <DataGridTextColumn Header="Current level" Width="110" IsReadOnly="True"
                                    Binding="{Binding CurrentLevel}"/>
                <DataGridTextColumn Header="Proposed level" Width="110" IsReadOnly="True"
                                    Binding="{Binding ProposedLevel}"/>
                <DataGridTextColumn Header="Current offset" Width="100" IsReadOnly="True"
                                    Binding="{Binding CurrentOffset}"/>
                <DataGridTextColumn Header="Proposed offset" Width="105" IsReadOnly="True"
                                    Binding="{Binding ProposedOffset}"/>
                <DataGridTextColumn Header="Status" Width="85" IsReadOnly="True"
                                    Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Message" Width="*" IsReadOnly="True"
                                    Binding="{Binding Message}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bulk selection -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Tick all shown" Style="{StaticResource SmallButton}"
                        Width="110" Click="on_check_shown"/>
                <Button Content="Untick all shown" Style="{StaticResource SmallButton}"
                        Width="110" Click="on_uncheck_shown"/>
                <Button Content="Untick selected rows" Style="{StaticResource SmallButton}"
                        Width="140" Click="on_uncheck_selected"/>
                <Button Content="Zoom to element" Style="{StaticResource SmallButton}"
                        Width="120" Click="on_zoom"/>
                <Button Content="Select in Revit" Style="{StaticResource SmallButton}"
                        Width="110" Click="on_select_in_revit"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="lbl_counts" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="#FF374151"/>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="lbl_status" VerticalAlignment="Center"
                       Foreground="#FF6B7280" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Export preview (CSV)" Style="{StaticResource ActionButton}"
                        Width="160" Click="on_export"/>
                <Button Content="Cancel" Style="{StaticResource ActionButton}"
                        Click="on_cancel"/>
                <Button x:Name="btn_apply" Content="Apply changes"
                        Style="{StaticResource ActionButton}"
                        Background="#FF2A6099" Foreground="White"
                        FontWeight="SemiBold" Click="on_apply"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
